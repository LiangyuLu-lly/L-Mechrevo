	internal static bool SwitchShouldReportFailure(bool serviceConfirmed, int hardwareProfile, int requestedProfile)
	{
		if (!serviceConfirmed)
		{
			return hardwareProfile != requestedProfile;
		}
		return false;
	}

	private int D(int value)
	{
		return ResponsiveLayout.LogicalToDevice(this, value);
	}

