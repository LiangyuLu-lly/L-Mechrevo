<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.LicensesWindow_Text_10}"
        Width="680" Height="620"
        MinWidth="560" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_10}" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_9}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,14" />

                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_8}" FontWeight="Bold" Margin="0,4,0,6" />
                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_7}" TextWrapping="Wrap" />
                <TextBlock Text="irusanov/ZenStates-Core — GPL-3.0" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_6}" FontWeight="Bold" Margin="0,14,0,6" />
                <TextBlock Text="PawnIO.Modules RyzenSMU.bin / IntelMSR.bin — LGPL-2.1-or-later" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_5}" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_4}" FontWeight="Bold" Margin="0,14,0,6" />
                <TextBlock Text="leogx9r/ryzen_smu — GPL-2.0" />
                <TextBlock Text="FlyGoat/RyzenAdj — LGPL-3.0" />
                <TextBlock Text="JamesCJ60/Universal-x86-Tuning-Utility — GPL-3.0" />
                <TextBlock Text="kitsunyan/intel-undervolt — GPL-3.0" />
                <TextBlock Text="tomups/watercooler-manager — GPL-3.0" />
                <TextBlock Text="irusanov/SMUDebugTool — GPL-3.0" />
                <TextBlock Text="Leo-stro/mechrevo-charge-limit — MIT" />
                <TextBlock Text="IYATT-yx/NullSignal — MIT" />
                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_3}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:WpfStrings.WujieFanTableLicense}" TextWrapping="Wrap" />
                <TextBlock Text="https://github.com/Qxingyue/-14XA-Uniwill-EC-" TextWrapping="Wrap" />
                <TextBlock Text="faintonce/open-revo — GPL-3.0" />
                <TextBlock Text="https://github.com/faintonce/open-revo" TextWrapping="Wrap" />
                <TextBlock Text="GaoXanSheng/JiaolongControl — MIT" />
                <TextBlock Text="KanzakiK/DOUZHANZHE-Control — GPL-3.0" />

                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text_2}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                <TextBlock Text="{x:Static loc:WpfStrings.LicensesWindow_Text}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:WpfStrings.LicensesWindow_Content}" Style="{StaticResource FlatButton}" Click="OpenFolder_Click" />
            <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content}" Style="{StaticResource FlatButton}" Click="Close_Click" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
