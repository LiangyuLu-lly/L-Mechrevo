<Window x:Class="L_Mechrevo.WpfP0.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="380" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        Icon="Assets/Icons/app.png">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="输入：" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Height="28" VerticalContentAlignment="Center"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Style="{StaticResource FlatButton}" Click="Ok_Click" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="取消" Style="{StaticResource FlatButton}" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
