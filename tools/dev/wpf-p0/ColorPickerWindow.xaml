<Window x:Class="L_Mechrevo.WpfP0.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="340" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="预设颜色" FontSize="14" FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <UniformGrid x:Name="PresetGrid" Columns="6" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{DynamicResource MutedText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="自定义…" Style="{StaticResource FlatButton}" Click="Custom_Click" />
                <Button Content="取消" Style="{StaticResource FlatButton}" Click="Cancel_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
