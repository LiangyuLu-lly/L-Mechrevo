<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.ColorPickerWindow_Title}"
        Width="340" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static loc:WpfStrings.ColorPickerWindow_Text}" FontSize="14" FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <UniformGrid x:Name="PresetGrid" Columns="6" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{DynamicResource MutedText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:WpfStrings.ColorPickerWindow_Content_2}" Style="{StaticResource FlatButton}" Click="Custom_Click" />
                <Button Content="{x:Static loc:WpfStrings.ColorPickerWindow_Content}" Style="{StaticResource FlatButton}" Click="Cancel_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
