<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.CalibrationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.CalibrationSettingsWindow_Text_3}"
        Width="560" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">
    <Window.Resources>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static loc:WpfStrings.CalibrationSettingsWindow_Text_3}" Style="{StaticResource TitleText}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <CheckBox x:Name="StartupSwitch" Content="{x:Static loc:WpfStrings.StartupSwitch_Content}" Style="{StaticResource HeaderSwitch}"
                      Click="StartupSwitch_Click" />
            <TextBlock Text="{x:Static loc:WpfStrings.CalibrationSettingsWindow_Text_2}"
                       Style="{StaticResource HintText}" Margin="0,6,0,0" />
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,16,0,12" Background="{DynamicResource CardBorderBrush}" Height="1" />

        <StackPanel Grid.Row="3">
            <CheckBox x:Name="CustomSwitch" Content="{x:Static loc:WpfStrings.CustomSwitch_Content}" Style="{StaticResource HeaderSwitch}" Click="CustomSwitch_Click" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="IccCombo" Style="{DynamicResource RoundCombo}" SelectionChanged="IccCombo_SelectionChanged" />
                <Button x:Name="ImportButton" Grid.Column="1" Content="{x:Static loc:WpfStrings.ImportButton_Content}" Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Click="ImportButton_Click" />
                <Button x:Name="CloudButton" Grid.Column="2" Content="{x:Static loc:WpfStrings.CloudIcc_Content}" Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Click="CloudButton_Click" Visibility="Collapsed" />
            </Grid>
            <TextBlock Text="{x:Static loc:WpfStrings.CalibrationSettingsWindow_Text}"
                       Style="{StaticResource HintText}" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Window>
