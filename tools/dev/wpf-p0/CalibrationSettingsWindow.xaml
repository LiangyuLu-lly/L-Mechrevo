<Window x:Class="L_Mechrevo.WpfP0.CalibrationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕校色"
        Width="560" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="屏幕校色" Style="{StaticResource TitleText}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <CheckBox x:Name="StartupSwitch" Content="开机自动应用校色" Style="{StaticResource HeaderSwitch}"
                      Click="StartupSwitch_Click" />
            <TextBlock Text="开启后，每次开机将自动应用一次当前校色。一般无需开启，仅当重启后校色无法保持时使用。"
                       Style="{StaticResource HintText}" Margin="0,6,0,0" />
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,16,0,12" Background="{DynamicResource CardBorderBrush}" Height="1" />

        <StackPanel Grid.Row="3">
            <CheckBox x:Name="CustomSwitch" Content="自定义校色" Style="{StaticResource HeaderSwitch}" Click="CustomSwitch_Click" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="IccCombo" Style="{DynamicResource RoundCombo}" SelectionChanged="IccCombo_SelectionChanged" />
                <Button x:Name="ImportButton" Grid.Column="1" Content="导入" Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Click="ImportButton_Click" />
            </Grid>
            <TextBlock Text="开启后，校色下拉列表将出现「自定义」选项，经 Windows 颜色管理应用所选 ICC（不经由 GCU）；关闭则取消所有已应用 ICC。"
                       Style="{StaticResource HintText}" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Window>
