<Window x:Class="L_Mechrevo.WpfP0.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L-Mechrevo · 紧凑 P0"
        Width="420" Height="529"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">

    <Window.Resources>
        <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style x:Key="CompactSegment" TargetType="ToggleButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CompactSwitch" TargetType="CheckBox" BasedOn="{StaticResource SwitchBox}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.78" />
        <Rectangle x:Name="BackgroundScrim" Fill="#99000000" Opacity="0.35" />

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="L" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="L-Mechrevo" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="紧凑 P0 · 420×529" Style="{StaticResource MutedText}" FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="宽屏" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,5" Click="WideButton_Click" Margin="0,0,6,0" />
                    <Button x:Name="ThemeButton" Content="浅色" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,5" Click="ThemeButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" CanContentScroll="False" Background="Transparent">
                <StackPanel>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="性能模式" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="平衡" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <ToggleButton Content="平衡" Tag="0" Style="{StaticResource CompactSegment}" Click="Mode_Click" />
                                <ToggleButton Content="狂暴" Tag="1" Style="{StaticResource CompactSegment}" Click="Mode_Click" />
                                <ToggleButton Content="自定义" Tag="3" Style="{StaticResource CompactSegment}" Click="Mode_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <TextBlock Text="显卡模式" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <ToggleButton Content="核显" Tag="0" Style="{StaticResource CompactSegment}" Click="Gpu_Click" />
                                <ToggleButton Content="混合" Tag="1" Style="{StaticResource CompactSegment}" IsChecked="True" Click="Gpu_Click" />
                                <ToggleButton Content="独显" Tag="2" Style="{StaticResource CompactSegment}" Click="Gpu_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="核显省电" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="IgpuSavingStatus" Grid.Column="1" Text="当前：自动" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <ToggleButton x:Name="IgpuSavingOffButton" Content="关" Style="{StaticResource CompactSegment}" Click="IgpuSaving_Click" />
                                <ToggleButton x:Name="IgpuSavingOnButton" Content="开" Style="{StaticResource CompactSegment}" Click="IgpuSaving_Click" />
                                <ToggleButton x:Name="IgpuSavingAutoButton" Content="自动" Style="{StaticResource CompactSegment}" IsChecked="True" Click="IgpuSaving_Click" />
                            </StackPanel>
                            <TextBlock x:Name="IgpuSavingHint" Text="仅 UI 预览，硬件切换与安全门待接入" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <TextBlock Text="快捷开关" FontSize="12" FontWeight="SemiBold" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="174" />
                                    <ColumnDefinition Width="174" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="无线网络" Tag="wifi" Width="174" HorizontalAlignment="Left" Style="{StaticResource CompactSwitch}" Click="QuickSwitch_Click" IsChecked="True" Margin="0,4,4,4" />
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="蓝牙" Tag="bt" Width="174" HorizontalAlignment="Left" Style="{StaticResource CompactSwitch}" Click="QuickSwitch_Click" IsChecked="True" Margin="4,4,0,4" />
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="摄像头" Tag="webcam" Width="174" HorizontalAlignment="Left" Style="{StaticResource CompactSwitch}" Click="QuickSwitch_Click" Margin="0,4,4,4" />
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="麦克风" Tag="micmute" Width="174" HorizontalAlignment="Left" Style="{StaticResource CompactSwitch}" Click="QuickSwitch_Click" Margin="4,4,0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU 56 ℃ · GPU 47 ℃" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="风扇 30%" Style="{StaticResource MutedText}" FontSize="10" />
                            </Grid>
                            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="30"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0" />
                            <TextBlock Text="CPU / GPU 温度与风扇占空比" Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="电池" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="82%" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                            </Grid>
                            <Slider Minimum="40" Maximum="100" Value="80" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="限制充电" Style="{StaticResource CompactSwitch}" IsChecked="True" Margin="0,0,16,0" />
                                <CheckBox Content="电压修复" Style="{StaticResource CompactSwitch}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="风扇曲线" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="CPU 30% · GPU 30%" Style="{StaticResource MutedText}" FontSize="10" />
                            </Grid>
                            <Border Height="62" Margin="0,8,0,0" Background="#18000000" CornerRadius="8" ClipToBounds="True">
                                <Canvas Background="Transparent">
                                    <Polyline Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                              Points="10,52 60,46 110,34 160,22 210,14 260,10 310,8" />
                                    <Polyline Stroke="#55FFFFFF" StrokeThickness="1.2"
                                              Points="10,56 60,50 110,42 160,32 210,24 260,18 310,14" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景不透明度" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock Grid.Column="1" x:Name="OpacityLabel" Text="78%" Style="{StaticResource MutedText}" FontSize="10" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="78" Margin="0,3,0,0"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="P0 紧凑布局：与 WinForms 原版 420×529 同尺寸；背景/卡片/滚动/主题仍可验证。"
                               Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="2,0,2,8" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="紧凑 P0 · 420×529" Style="{StaticResource MutedText}" FontSize="10" />
                <TextBlock Grid.Column="1" Text="原型" Style="{StaticResource MutedText}" FontSize="10" />
            </Grid>
        </Grid>
    </Grid>
</Window>
