<Window x:Class="L_Mechrevo.WpfP0.FirstRunGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L-Mechrevo"
        Width="620"
        Height="600"
        MinWidth="520"
        MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">
    <Window.Resources>
        <!-- 与原 WinForms 引导一致：普通步骤用强调色圆角标记，警告步骤用红色系 -->
        <SolidColorBrush x:Key="FirstRunWarnBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="FirstRunWarnBgBrush" Color="#33EF4444" />

        <!-- 复用 App.xaml 的 SegmentButton / GhostButton，仅按本对话框收窄尺寸 -->
        <Style x:Key="FirstRunSegButton" TargetType="ToggleButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="FirstRunGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="FirstRunPrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区：完整引导 = 大标题 + 引言；单问模式只用一行辅助说明（与 WinForms 版等价） -->
        <Border x:Name="HeaderCard" Grid.Row="0" Style="{StaticResource Card}"
                Margin="18,18,18,10" Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource SectionTitle}"
                           FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="HeaderIntro" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 步骤区：完整引导可滚动；单问模式内容高度自适应（Disabled ⇒ 不出现滚动条） -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Margin="18,0,18,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="StepsPanel" Margin="0,0,0,4" />
        </ScrollViewer>

        <!-- 按钮区：与原版的「左三分之一：稍后 / 中三分之一：主按钮」布局一致 -->
        <Grid Grid.Row="2" Margin="18,10,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LaterButton" Grid.Column="0" Style="{StaticResource FirstRunGhostButton}"
                    Click="Later_Click" />
            <Button x:Name="OkButton" Grid.Column="1" Style="{StaticResource FirstRunPrimaryButton}"
                    Click="Ok_Click" />
        </Grid>
    </Grid>
</Window>
