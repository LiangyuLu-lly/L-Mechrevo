<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.LightEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.TitleText_Text_2}"
        Width="580" SizeToContent="Height" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Window.Resources>
        <Style x:Key="HeaderSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="24" Height="14" CornerRadius="7"
                                    Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White"
                                             VerticalAlignment="Center" HorizontalAlignment="Left" Margin="1,0,0,0" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,1,1,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="52" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoundSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{x:Static loc:WpfStrings.TitleText_Text_2}" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="HintText" Text="{x:Static loc:WpfStrings.HintText_Text_2}" Style="{DynamicResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="EffectRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_7}" VerticalAlignment="Center" />
                <ComboBox x:Name="EffectCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectionChanged="Effect_Changed" />
            </Grid>
            <Grid x:Name="PowerRow" Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_6}" VerticalAlignment="Center" />
                <CheckBox x:Name="PowerCheck" Grid.Column="1" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{x:Static loc:WpfStrings.LightEditorWindow_Text_6}" Style="{DynamicResource MutedText}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_4}" VerticalAlignment="Center" />
                <Slider x:Name="LightSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="100" ValueChanged="Light_Changed" />
                <TextBlock x:Name="LightText" Grid.Column="2" Text="100" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="SpeedRow" Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_3}" VerticalAlignment="Center" />
                <Slider x:Name="SpeedSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="4" Value="1" ValueChanged="Speed_Changed" />
                <TextBlock x:Name="SpeedText" Grid.Column="2" Text="20" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="ColorRow" Grid.Row="4" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.MultiColorLabel_Text}" VerticalAlignment="Center" />
                <Button x:Name="ColorButton" Grid.Column="1" Content="{x:Static loc:WpfStrings.ColorPickerWindow_Title}" Style="{StaticResource FlatButton}" Click="Color_Click" />
            </Grid>
            <Border x:Name="MixRow" Grid.Row="5" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:WpfStrings.LightEditorWindow_Text_5}" Style="{DynamicResource MutedText}" Margin="0,0,0,6" />
                    <UniformGrid x:Name="MixGrid" Columns="7" />
                    <Button Content="{x:Static loc:WpfStrings.LightEditorWindow_Content}" Style="{StaticResource MiniButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ResetMix_Click" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="KeyboardExtraRow" Grid.Row="6" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid x:Name="PerKeyPanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static loc:WpfStrings.LightEditorWindow_Text_4}" VerticalAlignment="Center" />
                    <Slider x:Name="PerKeySlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="2" Maximum="10" Value="5" ValueChanged="PerKey_Changed" />
                    <TextBlock x:Name="PerKeyText" Grid.Column="2" Text="5/10" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="ManualPalettePanel" Margin="0,6,0,0">
                    <TextBlock Text="{x:Static loc:WpfStrings.LightEditorWindow_Text_3}" Style="{DynamicResource MutedText}" Margin="0,0,0,4" />
                    <UniformGrid x:Name="ManualPaletteGrid" Columns="6" Width="240" Height="34" HorizontalAlignment="Left" />
                    <Button x:Name="ManualResetButton" Content="恢复默认六色" Style="{StaticResource MiniButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ManualReset_Click" />
                </StackPanel>
                <StackPanel x:Name="BreathPanel" Margin="0,6,0,0">
                    <TextBlock Text="{x:Static loc:WpfStrings.LightEditorWindow_Text_2}" Style="{DynamicResource MutedText}" Margin="0,0,0,4" />
                    <UniformGrid x:Name="BreathGrid" Columns="4" Width="200" Height="34" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{DynamicResource MutedText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{x:Static loc:WpfStrings.LightEditorWindow_Text}" Style="{DynamicResource MutedText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
