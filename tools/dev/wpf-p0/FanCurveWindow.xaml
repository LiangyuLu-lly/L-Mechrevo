<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:L_Mechrevo.WpfP0"
        Title="{x:Static loc:WpfStrings.CustomModeWindow_Content}"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{x:Static loc:WpfStrings.CustomModeWindow_Content}" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="HintText" Text="{x:Static loc:WpfStrings.HintText_Text}" Style="{DynamicResource MutedText}" Margin="0,4,0,10" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="CpuSection">
                    <TextBlock Text="{x:Static loc:WpfStrings.FanCurveWindow_Text_2}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <local:FanCurveCanvas x:Name="CpuCurve" />
                </StackPanel>
                <StackPanel x:Name="GpuSection" Margin="0,12,0,0">
                    <TextBlock Text="{x:Static loc:WpfStrings.FanCurveWindow_Text}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <local:FanCurveCanvas x:Name="GpuCurve" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Style="{DynamicResource MutedText}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="WujieIndependentCheck" Content="{x:Static loc:WpfStrings.WujieIndependentCheck_Content}" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed" />
                <CheckBox x:Name="BaolongdaLoopCheck" Content="{x:Static loc:WpfStrings.FanCurveBaolongdaEnable_Content}" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed" />
                <CheckBox x:Name="BaolongdaSyncCheck" Content="{x:Static loc:WpfStrings.FanSyncSharedHeatPipe_Content}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed" />
                <CheckBox x:Name="PushFanCurveCheck" Content="{x:Static loc:WpfStrings.PushFanCurveCheck_Content}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="{x:Static loc:WpfStrings.FanCurveRestoreDefault_Content}" Style="{StaticResource FlatButton}" Click="RestoreDefault_Click" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:WpfStrings.ApplyButton_Content}" Style="{StaticResource FlatButton}" Click="Apply_Click" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content}" Style="{StaticResource FlatButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
