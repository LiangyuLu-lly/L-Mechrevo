<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.SponsorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.SponsorWindow_Text_5}"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{x:Static loc:WpfStrings.SponsorWindow_Text_5}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{x:Static loc:WpfStrings.SponsorWindow_Text_4}"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16" />

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:WpfStrings.SponsorWindow_Text_3}" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <TextBlock Text="LiangyuLu-lly" FontWeight="Bold" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <Image Source="Assets/Resources/qrcode1.jpg" Height="180" Stretch="Uniform" Margin="0,0,6,0" />
                            <Image Source="Assets/Resources/qrcode2.jpg" Height="180" Stretch="Uniform" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:WpfStrings.SponsorWindow_Text_2}" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <TextBlock Text="xiaohan (xmsjx)" FontWeight="Bold" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <Image Source="Assets/Resources/qrcode3.png" Height="180" Stretch="Uniform" Margin="0,0,6,0" />
                            <Image Source="Assets/Resources/qrcode4.png" Height="180" Stretch="Uniform" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{x:Static loc:WpfStrings.SponsorWindow_Text}"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
