<Window x:Class="L_Mechrevo.WpfP0.SponsorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赞助 L-Mechrevo"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="赞助 L-Mechrevo" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="感谢你支持 L-Mechrevo 的维护与更新。以下二维码分别对应原项目与当前维护者，请按需扫码。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16" />

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="原项目" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <TextBlock Text="LiangyuLu-lly" FontWeight="Bold" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <Image Source="Assets/Resources/qrcode1.jpg" Height="180" Stretch="Uniform" Margin="0,0,6,0" />
                            <Image Source="Assets/Resources/qrcode2.jpg" Height="180" Stretch="Uniform" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="本版维护者" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <TextBlock Text="xiaohan (xmsjx)" FontWeight="Bold" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <Image Source="Assets/Resources/qrcode3.png" Height="180" Stretch="Uniform" Margin="0,0,6,0" />
                            <Image Source="Assets/Resources/qrcode4.png" Height="180" Stretch="Uniform" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="二维码仅用于赞助；L-Mechrevo 本身开源，不提供付费功能解锁。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
