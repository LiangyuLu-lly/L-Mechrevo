<Window x:Class="L_Mechrevo.WpfP0.CustomModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="性能模式"
        Width="640" Height="780"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ApplyButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#C62828" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="性能模式 · 自定义" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="模式" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ModeCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectionChanged="ModeCombo_SelectionChanged" />
                <Button Content="新建" Grid.Column="2" Style="{StaticResource MiniButton}" Click="New_Click" Margin="8,0,0,0" />
                <Button Content="重命名" Grid.Column="3" Style="{StaticResource MiniButton}" Click="Rename_Click" Margin="6,0,0,0" />
                <Button Content="删除" Grid.Column="4" Style="{StaticResource MiniButton}" Click="Delete_Click" Margin="6,0,0,0" />
            </Grid>
            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,8" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="SystemCard" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="系统" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Windows 电源模式" VerticalAlignment="Center" />
                            <ComboBox x:Name="PowerModeCombo" Grid.Column="1" Style="{StaticResource RoundCombo}">
                                <ComboBoxItem Content="不改变" Tag="" />
                                <ComboBoxItem Content="能效优先" Tag="0" />
                                <ComboBoxItem Content="平衡" Tag="1" />
                                <ComboBoxItem Content="高性能" Tag="2" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CPU 睿频模式" VerticalAlignment="Center" />
                            <ComboBox x:Name="CpuBoostCombo" Grid.Column="1" Style="{StaticResource RoundCombo}">
                                <ComboBoxItem Content="不改变" Tag="" />
                                <ComboBoxItem Content="开启" Tag="1" />
                                <ComboBoxItem Content="关闭" Tag="0" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="屏幕刷新率" VerticalAlignment="Center" />
                            <ComboBox x:Name="RefreshCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" />
                        </Grid>
                        <Grid x:Name="FanBoostRow" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="风扇增强" VerticalAlignment="Center" />
                            <ComboBox x:Name="FanBoostCombo" Grid.Column="1" Style="{StaticResource RoundCombo}">
                                <ComboBoxItem Content="不改变" Tag="" />
                                <ComboBoxItem Content="开启" Tag="1" />
                                <ComboBoxItem Content="关闭" Tag="0" />
                            </ComboBox>
                        </Grid>

                    </StackPanel>
                </Border>

                <Border x:Name="CpuPowerCard" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="CPU 功耗" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CPU 功耗墙 PL1 (W)" VerticalAlignment="Center" />
                            <Slider x:Name="Pl1Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="5" Maximum="200" Value="65" ValueChanged="Pl1_Changed" />
                            <TextBlock x:Name="Pl1Text" Grid.Column="2" Text="65" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CPU 功耗墙 PL2 (W)" VerticalAlignment="Center" />
                            <Slider x:Name="Pl2Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="5" Maximum="200" Value="65" ValueChanged="Pl2_Changed" />
                            <TextBlock x:Name="Pl2Text" Grid.Column="2" Text="65" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="Pl4Row" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CPU 峰值功耗 fPPT (W)" VerticalAlignment="Center" />
                            <Slider x:Name="Pl4Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="5" Maximum="250" Value="100" ValueChanged="Pl4_Changed" />
                            <TextBlock x:Name="Pl4Text" Grid.Column="2" Text="100" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TempGpuCard" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="温度 / GPU 动态加速" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CPU 温度墙" VerticalAlignment="Center" />
                            <CheckBox x:Name="TccSwitch" Grid.Column="1" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="TccSlider" Grid.Column="2" Style="{StaticResource RoundSlider}" Minimum="75" Maximum="100" Value="95" ValueChanged="Tcc_Changed" />
                            <TextBlock x:Name="TccText" Grid.Column="3" Text="95" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="GPU 动态加速" VerticalAlignment="Center" />
                            <CheckBox x:Name="DbSwitch" Grid.Column="1" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" Checked="DbSwitch_Changed" Unchecked="DbSwitch_Changed" />
                            <Slider x:Name="DbSlider" Grid.Column="2" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="30" Value="25" ValueChanged="Db_Changed" />
                            <TextBlock x:Name="DbText" Grid.Column="3" Text="25" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="GPU 功耗上限 TGP (W)" VerticalAlignment="Center" />
                            <Slider x:Name="GpuTgpSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="5" Maximum="250" Value="100" ValueChanged="GpuTgp_Changed" />
                            <TextBlock x:Name="GpuTgpText" Grid.Column="2" Text="100" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="FanCard" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="风扇 / 超频" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="风扇转换灵敏度" VerticalAlignment="Center" />
                            <CheckBox x:Name="FanSensitivitySwitch" Grid.Column="1" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" Checked="FanSensitivitySwitch_Changed" Unchecked="FanSensitivitySwitch_Changed" />
                            <Slider x:Name="FanDelaySlider" Grid.Column="2" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="1000" Value="300" ValueChanged="FanDelay_Changed" />
                            <TextBlock x:Name="FanDelayText" Grid.Column="3" Text="300" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="GPU 超频" VerticalAlignment="Center" />
                            <CheckBox x:Name="GpuOcSwitch" Grid.Column="1" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="2" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="核心偏移 (MHz)" VerticalAlignment="Center" />
                            <Slider x:Name="CoreOffsetSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="-500" Maximum="500" Value="0" ValueChanged="CoreOffset_Changed" />
                            <TextBlock x:Name="CoreOffsetText" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="显存偏移 (MHz)" VerticalAlignment="Center" />
                            <Slider x:Name="MemoryOffsetSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="-1000" Maximum="2000" Value="0" ValueChanged="MemoryOffset_Changed" />
                            <TextBlock x:Name="MemoryOffsetText" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="应用" Style="{StaticResource ApplyButton}" Click="Apply_Click" />
            <Button Content="恢复出厂" Style="{StaticResource FooterButton}" Click="Restore_Click" />
            <Button Content="风扇曲线" Style="{StaticResource FooterButton}" Click="FanCurve_Click" />
            <Button Content="CPU 调节" Style="{StaticResource FooterButton}" Click="CpuTuning_Click" />
        </StackPanel>
    </Grid>
</Window>
