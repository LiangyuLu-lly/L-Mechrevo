<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.WaterCoolerCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:L_Mechrevo.WpfP0"
        Title="水冷风扇曲线"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="水冷风扇曲线" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="拖动曲线点设置温度对应的风扇占空比；应用后由 LM 按温度插值下发到水冷。" Style="{DynamicResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="标准" Style="{StaticResource FlatButton}" Click="PresetStandard_Click" Margin="0,0,8,0" />
                <Button Content="静音" Style="{StaticResource FlatButton}" Click="PresetQuiet_Click" Margin="0,0,8,0" />
                <Button Content="激进" Style="{StaticResource FlatButton}" Click="PresetAggressive_Click" Margin="0,0,8,0" />
                <Button Content="线性" Style="{StaticResource FlatButton}" Click="PresetLinear_Click" />
            </StackPanel>
            <Grid Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="水泵启泵温度" Style="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="PumpStartSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="30" Maximum="90" Value="55" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="PumpStart_ValueChanged" />
                <TextBlock x:Name="PumpStartValue" Grid.Column="2" Width="48" Margin="14,0,0,0" Text="55°C" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="水泵狂暴温度" Style="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="PumpTurboSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="35" Maximum="100" Value="90" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="PumpTurbo_ValueChanged" />
                <TextBlock x:Name="PumpTurboValue" Grid.Column="2" Width="48" Margin="14,0,0,0" Text="90°C" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
        <local:WaterCoolerCurveCanvas x:Name="CurveCanvas" Grid.Row="1" />
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Style="{DynamicResource MutedText}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="解除水冷绑定" Style="{StaticResource FlatButton}" Click="Unbind_Click" Margin="0,0,8,0" />
                <Button Content="恢复默认" Style="{StaticResource FlatButton}" Click="Restore_Click" Margin="0,0,8,0" />
                <Button Content="应用" Style="{StaticResource FlatButton}" Click="Apply_Click" Margin="0,0,8,0" />
                <Button Content="关闭" Style="{StaticResource FlatButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
