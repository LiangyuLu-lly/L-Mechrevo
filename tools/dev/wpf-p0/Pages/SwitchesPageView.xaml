<UserControl x:Class="L_Mechrevo.WpfP0.Pages.SwitchesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="SwitchesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Text="更多开关" Style="{StaticResource PageTitle}" />
            <TextBlock Text="以磁贴形式排列的快捷开关" Style="{StaticResource MutedText}" Margin="0,3,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="MoreSwitchGrid" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
