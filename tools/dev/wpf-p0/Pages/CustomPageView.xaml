<UserControl xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.Pages.CustomPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    </UserControl.Resources>
<ScrollViewer x:Name="CustomPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:WpfStrings.NavCustom_Content}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text_6}" Style="{StaticResource MutedText}" Margin="0,3,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text_5}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text_4}" Style="{StaticResource MutedText}" Margin="0,3,0,12" />
                                        <ContentControl x:Name="CustomModeHost" Margin="0,0,0,10" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text_3}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text}" Style="{StaticResource MutedText}" Margin="0,3,0,12" />
                                            <ContentControl x:Name="CpuFanCurveHost" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text_2}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{x:Static loc:WpfStrings.CustomPageView_Text}" Style="{StaticResource MutedText}" Margin="0,3,0,12" />
                                            <ContentControl x:Name="GpuFanCurveHost" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
