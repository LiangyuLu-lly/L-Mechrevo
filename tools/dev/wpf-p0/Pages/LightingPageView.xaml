<UserControl xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.Pages.LightingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    </UserControl.Resources>
<ScrollViewer x:Name="LightingPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:WpfStrings.TitleText_Text_2}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static loc:WpfStrings.LightingPageView_Text_2}" Style="{StaticResource MutedText}" Margin="0,3,0,10" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{x:Static loc:WpfStrings.LightingPageView_Text}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="LightingOffBatteryToggle" Content="{x:Static loc:WpfStrings.LightOffOnBatteryCheck_Content}" Style="{StaticResource SegmentButton}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Static loc:WpfStrings.OriginalStyleWindow_Text_6}" Style="{StaticResource MutedText}" Margin="0,10,0,6" />
                                    <WrapPanel x:Name="LightingIdlePanel" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="LightingCardsGrid" />
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
