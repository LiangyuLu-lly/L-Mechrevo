<UserControl x:Class="L_Mechrevo.WpfP0.Pages.LightingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    </UserControl.Resources>
<ScrollViewer x:Name="LightingPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="灯光" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="键盘、灯带、Logo、铰链与同步灯" Style="{StaticResource MutedText}" Margin="0,3,0,10" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="全局灯光" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="LightingOffBatteryToggle" Content="离电自动关闭全部灯效" Style="{StaticResource SegmentButton}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="自动关闭时间" Style="{StaticResource MutedText}" Margin="0,10,0,6" />
                                    <WrapPanel x:Name="LightingIdlePanel" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="LightingCardsGrid" />
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
