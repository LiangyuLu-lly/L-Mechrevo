<UserControl xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.Pages.ScreenPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}">
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    </UserControl.Resources>
<ScrollViewer x:Name="ScreenPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:WpfStrings.NavScreen_Content}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static loc:WpfStrings.ScreenPageView_Text_5}" Style="{StaticResource MutedText}" Margin="0,3,0,10" />
                            <Border x:Name="ScreenCalibrationCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{x:Static loc:WpfStrings.CalibrationSettingsWindow_Text_3}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="ScreenCalibrationToggle" Content="{x:Static loc:WpfStrings.ScreenCalibrationToggle_Content}" Style="{StaticResource SegmentButton}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Static loc:WpfStrings.ScreenPageView_Text_4}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                                    <WrapPanel x:Name="ScreenCalibrationOptionsPanel" />
                                    <Button x:Name="ScreenCalibrationSettingsButton" Content="{x:Static loc:WpfStrings.ScreenCalibrationSettingsButton_Content}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    <StackPanel x:Name="ScreenCalibrationSettingsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <CheckBox x:Name="CalibrationStartupSwitch" Content="{x:Static loc:WpfStrings.StartupSwitch_Content}" Style="{StaticResource HeaderSwitch}" />
                                        <CheckBox x:Name="CalibrationCustomSwitch" Content="{x:Static loc:WpfStrings.CalibrationCustomSwitch_Content}" Style="{StaticResource HeaderSwitch}" Margin="0,8,0,0" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CalibrationIccCombo" Style="{StaticResource RoundCombo}" Height="30" />
                                            <Button Grid.Column="1" Content="{x:Static loc:WpfStrings.ScreenPageView_Content}" Style="{StaticResource FlatButton}" Margin="8,0,0,0" x:Name="ScreenPageEventControl1"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ScreenFeaturesCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:WpfStrings.ScreenPageView_Text_3}" Style="{StaticResource CardTitle}" />
                                    <StackPanel x:Name="ScreenFeaturesPanel" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ScreenEffectCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{x:Static loc:WpfStrings.DisplayEffectEditorWindow_Text}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="ScreenEffectToggle" Content="{x:Static loc:WpfStrings.ScreenEffectToggle_Content}" Style="{StaticResource SegmentButton}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Static loc:WpfStrings.ScreenPageView_Text_2}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                                    <WrapPanel x:Name="ScreenEffectOptionsPanel" />
                                    <Button x:Name="ScreenEffectEditButton" Content="{x:Static loc:WpfStrings.ScreenEffectEditButton_Content}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    <StackPanel x:Name="ScreenEffectEditorPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Grid>
                                            <TextBlock Text="{x:Static loc:WpfStrings.ScreenPageView_Text}" Style="{StaticResource CardTitle}" />
                                            <Button Content="{x:Static loc:WpfStrings.DisplayEffectEditorWindow_Content}" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" x:Name="ScreenPageEventControl2"/>
                                        </Grid>
                                        <StackPanel x:Name="ScreenEffectSliderPanel" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
</UserControl>
