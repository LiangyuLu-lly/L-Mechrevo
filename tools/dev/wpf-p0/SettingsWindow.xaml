<Window x:Class="L_Mechrevo.WpfP0.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="380" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="CheckRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="界面" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DarkButton" Content="深色" Style="{StaticResource FlatButton}" Click="Dark_Click" />
                    <Button x:Name="LightButton" Content="浅色" Style="{StaticResource FlatButton}" Click="Light_Click" />
                </StackPanel>
                <CheckBox x:Name="FollowSystemCheck" Content="跟随系统主题" Style="{StaticResource CheckRow}" Click="FollowSystem_Click" />
                <CheckBox x:Name="BackgroundCheck" Content="启用背景图" Style="{StaticResource CheckRow}" Click="Background_Click" />

                <TextBlock Text="语言" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="中文" Style="{StaticResource FlatButton}" Click="Chinese_Click" />
                    <Button Content="English" Style="{StaticResource FlatButton}" Click="English_Click" />
                </StackPanel>

                <TextBlock Text="系统" Style="{StaticResource SectionText}" />
                <CheckBox x:Name="StartupCheck" Content="开机自启" Style="{StaticResource CheckRow}" Click="Startup_Click" />
                <CheckBox x:Name="WaterCoolingCheck" Content="强制启用水冷菜单" Style="{StaticResource CheckRow}" Click="WaterCooling_Click" />

                <TextBlock Text="核显模式显示" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="自动" Tag="auto" Style="{StaticResource FlatButton}" Click="IgpuRow_Click" />
                    <Button Content="显示" Tag="show" Style="{StaticResource FlatButton}" Click="IgpuRow_Click" />
                    <Button Content="隐藏" Tag="hide" Style="{StaticResource FlatButton}" Click="IgpuRow_Click" />
                </StackPanel>

                <TextBlock Text="灯带行显示" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="自动" Tag="auto" Style="{StaticResource FlatButton}" Click="LightStripRow_Click" />
                    <Button Content="显示" Tag="show" Style="{StaticResource FlatButton}" Click="LightStripRow_Click" />
                    <Button Content="隐藏" Tag="hide" Style="{StaticResource FlatButton}" Click="LightStripRow_Click" />
                </StackPanel>

                <TextBlock Text="Logo 灯行显示" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="自动" Tag="auto" Style="{StaticResource FlatButton}" Click="LightLogoRow_Click" />
                    <Button Content="显示" Tag="show" Style="{StaticResource FlatButton}" Click="LightLogoRow_Click" />
                    <Button Content="隐藏" Tag="hide" Style="{StaticResource FlatButton}" Click="LightLogoRow_Click" />
                </StackPanel>

                <TextBlock Text="日志" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="关" Style="{StaticResource FlatButton}" Click="LogOff_Click" />
                    <Button Content="仅错误" Style="{StaticResource FlatButton}" Click="LogError_Click" />
                    <Button Content="全部" Style="{StaticResource FlatButton}" Click="LogAll_Click" />
                </StackPanel>

                <TextBlock Text="设置备份" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="导出" Style="{StaticResource FlatButton}" Click="ExportBackup_Click" />
                    <Button Content="导入" Style="{StaticResource FlatButton}" Click="ImportBackup_Click" />
                </StackPanel>
                <TextBlock Text="不含日志；导入后需重启 LM 生效。" Style="{StaticResource SectionText}" Margin="0,2,0,0" />

                <TextBlock Text="关于" Style="{StaticResource SectionText}" />
                <TextBlock x:Name="VersionText" Text="0.293.5 beta23.5" FontSize="11" />
                <Button Content="打开安装目录" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenFolder_Click" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="关闭" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Close_Click" />
    </Grid>
</Window>
