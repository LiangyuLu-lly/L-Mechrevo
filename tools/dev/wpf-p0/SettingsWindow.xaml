<Window x:Class="L_Mechrevo.WpfP0.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="500" Height="760"
        MinWidth="500" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                            <ContentPresenter Margin="7,0,20,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 3 3 L 6 0" Stroke="{DynamicResource MutedBrush}"
                                                  StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Margin="0,3,0,0" Padding="3"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="32" Height="18" CornerRadius="9"
                                    Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,1,0,0" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,1,1,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复用主窗口的 RoundCombo / HeaderSwitch 样式 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="界面" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="FollowSystemCheck" Content="跟随系统" Style="{DynamicResource HeaderSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="FollowSystem_Click" />
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="界面外观" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="LightButton" Content="浅色" Style="{StaticResource ChoiceButton}" Click="Light_Click" />
                                <ToggleButton x:Name="DarkButton" Content="深色" Style="{StaticResource ChoiceButton}" Click="Dark_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="主题色" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="AccentSwatch" Width="34" Height="22" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                <Button Content="选择..." Style="{StaticResource FlatButton}" Click="PickAccent_Click" />
                                <Button Content="默认" Style="{StaticResource FlatButton}" Click="DefaultAccent_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="背景图" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="BackgroundPathText" Text="未选择" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}" />
                                <Button Content="选择..." Style="{StaticResource FlatButton}" Click="PickBackground_Click" />
                                <Button Content="清除" Style="{StaticResource FlatButton}" Click="ClearBackground_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="背景不透明度" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="BackgroundOpacitySlider" Width="150" Style="{DynamicResource RoundSlider}" Minimum="0" Maximum="100" Value="65"
                                        VerticalAlignment="Center" ValueChanged="BackgroundOpacity_Changed" />
                                <TextBlock x:Name="BackgroundOpacityText" Text="65%" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="背景遮罩" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="BackgroundScrimSlider" Width="150" Style="{DynamicResource RoundSlider}" Minimum="0" Maximum="100" Value="50"
                                        VerticalAlignment="Center" ValueChanged="BackgroundScrim_Changed" />
                                <TextBlock x:Name="BackgroundScrimText" Text="50%" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="底栏不透明度" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="DockOpacitySlider" Width="150" Style="{DynamicResource RoundSlider}" Minimum="0" Maximum="100" Value="70"
                                        VerticalAlignment="Center" ValueChanged="DockOpacity_Changed" />
                                <TextBlock x:Name="DockOpacityText" Text="70%" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="按钮不透明度" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="ButtonOpacitySlider" Width="150" Style="{DynamicResource RoundSlider}" Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center" ValueChanged="ButtonOpacity_Changed" />
                                <TextBlock x:Name="ButtonOpacityText" Text="100%" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,2,0,8">
                    <TextBlock Text="语言" Style="{StaticResource CardTitle}" />
                    <ComboBox x:Name="LanguageCombo" Width="150" HorizontalAlignment="Right" Style="{DynamicResource RoundCombo}"
                              SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="中文" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2,0,8">
                    <TextBlock Text="系统" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="快捷键" Style="{StaticResource FlatButton}" Click="Hotkeys_Click" Margin="0,0,12,0" />
                        <CheckBox x:Name="StartupCheck" Content="开机自启动" Style="{DynamicResource HeaderSwitch}"
                                  Margin="0,0,12,0" Click="Startup_Click" />
                        <CheckBox x:Name="WaterCoolingCheck" Content="强制启用水冷菜单" Style="{DynamicResource HeaderSwitch}" Click="WaterCooling_Click" />
                    </StackPanel>
                </Grid>

                <Border x:Name="DisplayCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="显示" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="OverdriveCheck" Content="显示响应加速 (LCD Overdrive)"
                                      Style="{DynamicResource HeaderSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="Overdrive_Click" />
                        </Grid>
                        <TextBlock Text="开启后降低 LCD 响应时间；部分面板可能增加轻微过冲。" Style="{StaticResource Hint}" />
                        <Grid x:Name="MiniledRow" Margin="0,6,0,0">
                            <TextBlock Text="MiniLED 分区控光" VerticalAlignment="Center" />
                            <CheckBox x:Name="MiniledCheck" Content="开启" Style="{DynamicResource HeaderSwitch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="Miniled_Click" />
                        </Grid>
                        <Grid x:Name="HdrControlRow" Margin="0,6,0,0">
                            <TextBlock Text="HDR Color Control" VerticalAlignment="Center" />
                            <CheckBox x:Name="HdrControlCheck" Content="开启" Style="{DynamicResource HeaderSwitch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="HdrControl_Click" />
                        </Grid>
                        <Grid x:Name="FhdRow" Margin="0,6,0,0">
                            <TextBlock Text="屏幕分辨率模式" VerticalAlignment="Center" />
                            <Button x:Name="FhdButton" Content="FHD" Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Right" Click="Fhd_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="官方控制台" Style="{StaticResource CardTitle}" />
                            <Button x:Name="IsolationButton" Content="隔离官方界面与托盘" Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Right" Click="Isolation_Click" />
                        </Grid>
                        <TextBlock x:Name="OfficialStatus" Text="未检测到官方控制台" Style="{StaticResource Hint}" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="PawnIO 驱动" VerticalAlignment="Center" />
                            <Button x:Name="ReinstallPawnButton" Content="重新安装" Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Right" Click="ReinstallPawnIO_Click" />
                        </Grid>
                        <TextBlock x:Name="PawnStatus" Text="PawnIO 驱动：检测中…" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="核显模式显示" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="IgpuAutoButton" Content="自动 (按硬件)" Tag="auto" Style="{StaticResource ChoiceButton}" Click="IgpuRow_Click" />
                                <ToggleButton x:Name="IgpuShowButton" Content="强制显示" Tag="show" Style="{StaticResource ChoiceButton}" Click="IgpuRow_Click" />
                                <ToggleButton x:Name="IgpuHideButton" Content="强制隐藏" Tag="hide" Style="{StaticResource ChoiceButton}" Click="IgpuRow_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="判断有误时选「强制显示」" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="灯带行显示" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="StripAutoButton" Content="自动 (按硬件)" Tag="auto" Style="{StaticResource ChoiceButton}" Click="LightStripRow_Click" />
                                <ToggleButton x:Name="StripShowButton" Content="强制显示" Tag="show" Style="{StaticResource ChoiceButton}" Click="LightStripRow_Click" />
                                <ToggleButton x:Name="StripHideButton" Content="强制隐藏" Tag="hide" Style="{StaticResource ChoiceButton}" Click="LightStripRow_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="判断有误时可选「强制显示」；即使有灯带，也可选「强制隐藏」" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Logo 灯行显示" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="LogoAutoButton" Content="自动 (按硬件)" Tag="auto" Style="{StaticResource ChoiceButton}" Click="LightLogoRow_Click" />
                                <ToggleButton x:Name="LogoShowButton" Content="强制显示" Tag="show" Style="{StaticResource ChoiceButton}" Click="LightLogoRow_Click" />
                                <ToggleButton x:Name="LogoHideButton" Content="强制隐藏" Tag="hide" Style="{StaticResource ChoiceButton}" Click="LightLogoRow_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="判断有误时可选「强制显示」；即使有 Logo 灯，也可选「强制隐藏」" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,2,0,8">
                    <TextBlock Text="日志级别" Style="{StaticResource CardTitle}" />
                    <ComboBox x:Name="LogLevelCombo" Width="150" HorizontalAlignment="Right" Style="{DynamicResource RoundCombo}"
                              SelectionChanged="LogLevel_Changed">
                        <ComboBoxItem Content="关" Tag="off" />
                        <ComboBoxItem Content="仅错误" Tag="error" />
                        <ComboBoxItem Content="全部" Tag="all" />
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设置备份" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="导出设置..." Style="{StaticResource FlatButton}" Click="ExportBackup_Click" />
                            <Button Content="导入设置..." Style="{StaticResource FlatButton}" Click="ImportBackup_Click" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="只含用户设置（不含日志）；导入前自动备份现有设置，导入后需重启 L-Mechrevo。" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="悬浮窗" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="显示内容" VerticalAlignment="Center" />
                            <ComboBox x:Name="OverlayModeCombo" Width="150" HorizontalAlignment="Right" Style="{DynamicResource RoundCombo}"
                                      SelectionChanged="OverlayMode_Changed">
                                <ComboBoxItem Content="极简" Tag="0" />
                                <ComboBoxItem Content="标准" Tag="1" />
                                <ComboBoxItem Content="完整" Tag="2" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="不透明度" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="OverlayOpacitySlider" Width="130" Style="{DynamicResource RoundSlider}" Minimum="30" Maximum="100" Value="100"
                                        VerticalAlignment="Center" ValueChanged="OverlayOpacity_Changed" />
                                <TextBlock x:Name="OverlayOpacityText" Text="100%" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="刷新间隔" VerticalAlignment="Center" />
                            <ComboBox x:Name="OverlayIntervalCombo" Width="150" HorizontalAlignment="Right" Style="{DynamicResource RoundCombo}"
                                      SelectionChanged="OverlayInterval_Changed">
                                <ComboBoxItem Content="0.5 秒" Tag="500" />
                                <ComboBoxItem Content="1 秒" Tag="1000" />
                                <ComboBoxItem Content="2 秒" Tag="2000" />
                                <ComboBoxItem Content="5 秒" Tag="5000" />
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="打开/关闭悬浮窗" Style="{StaticResource FlatButton}" Click="OverlayToggle_Click" />
                            <Button Content="重置位置" Style="{StaticResource FlatButton}" Click="OverlayReset_Click" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="桌面左键单击切换显示档；拖动可移动，位置会自动保存" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="AboutVersionText" Text="L-Mechrevo" Style="{StaticResource Hint}" />
                        <TextBlock Text="界面与功能持续从原版 L-Mechrevo 移植；反馈请附带诊断包。" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource FlatButton}" Click="CheckUpdate_Click" Margin="0,0,8,0" />
                            <Button Content="应用内反馈" Style="{StaticResource FlatButton}" Click="OpenFeedback_Click" Margin="0,0,8,0" />
                            <Button Content="项目主页 / 问题反馈" Style="{StaticResource FlatButton}" Click="OpenIssues_Click" />
                            <Button Content="许可证" Style="{StaticResource FlatButton}" Click="OpenLicenses_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,4,0,0">
                    <TextBlock x:Name="StatusText" Text="0.293.5 beta23.5" Style="{StaticResource Hint}" Margin="0" />
                    <Button Content="打开安装目录" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Click="OpenFolder_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
