<Window x:Class="L_Mechrevo.WpfP0.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="360" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="外观" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DarkButton" Content="深色" Style="{StaticResource FlatButton}" Click="Dark_Click" />
                <Button x:Name="LightButton" Content="浅色" Style="{StaticResource FlatButton}" Click="Light_Click" />
            </StackPanel>
            <CheckBox x:Name="BackgroundCheck" Content="启用背景图" Margin="0,8,0,0" Click="Background_Click" />

            <TextBlock Text="语言" Style="{StaticResource SectionText}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="中文" Style="{StaticResource FlatButton}" Click="Chinese_Click" />
                <Button Content="English" Style="{StaticResource FlatButton}" Click="English_Click" />
            </StackPanel>

            <TextBlock Text="日志" Style="{StaticResource SectionText}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="关" Style="{StaticResource FlatButton}" Click="LogOff_Click" />
                <Button Content="仅错误" Style="{StaticResource FlatButton}" Click="LogError_Click" />
                <Button Content="全部" Style="{StaticResource FlatButton}" Click="LogAll_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <TextBlock x:Name="VersionText" Text="0.293.5 beta23.5" Style="{StaticResource SectionText}" />
            <Button Content="打开安装目录" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="OpenFolder_Click" />
        </StackPanel>

        <Button Grid.Row="2" Content="关闭" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Close_Click" />
    </Grid>
</Window>
