<Window x:Class="L_Mechrevo.WpfP0.DisplayEffectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色彩增强"
        Width="470" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="色彩增强" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="恢复默认" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Click="ResetButton_Click" />
        </Grid>
        <StackPanel x:Name="SliderPanel" Grid.Row="1" Margin="0,14,0,8" />
    </Grid>
</Window>
