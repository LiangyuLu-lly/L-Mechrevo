<Window x:Class="L_Mechrevo.WpfP0.OriginalStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L-Mechrevo · 原版小窗 P0"
        Width="480" Height="860"
        MinWidth="420" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="StatText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BigSegment" TargetType="ToggleButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="RowSwitch" TargetType="CheckBox" BasedOn="{StaticResource SwitchBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.58" />
        <Rectangle x:Name="BackgroundScrim" Fill="#99000000" Opacity="0.45" />

        <Grid Margin="16,12,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部状态：模仿原版「GCU 已连接」 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="GCU 已连接" Foreground="#4ADE80" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="宽屏" Style="{StaticResource GhostButton}" FontSize="12" Padding="10,6" Click="WideButton_Click" Margin="0,0,6,0" />
                    <Button x:Name="ThemeButton" Content="浅色" Style="{StaticResource GhostButton}" FontSize="12" Padding="10,6" Click="ThemeButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" CanContentScroll="False" Background="Transparent">
                <StackPanel x:Name="ContentPanel" Width="440" HorizontalAlignment="Left">

                    <!-- 性能模式 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◔  " Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="性能模式" Style="{StaticResource SectionHeader}" Margin="0" />
                                <CheckBox Content="GPU 超频" Style="{StaticResource RowSwitch}" Margin="18,0,0,0" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="CPU 85℃   52W   4427rpm 100%" Style="{StaticResource StatText}" />
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,2,0,0">
                            <ToggleButton Content="静音" Style="{StaticResource BigSegment}" />
                            <ToggleButton Content="平衡" Style="{StaticResource BigSegment}" />
                            <ToggleButton Content="狂暴" Style="{StaticResource BigSegment}" IsChecked="True" />
                            <ToggleButton Content="自定义" Style="{StaticResource BigSegment}" Margin="0" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- 快捷开关 -->
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="⚙  快捷开关" Style="{StaticResource SectionHeader}" />
                        <UniformGrid Columns="3" Rows="2">
                            <ToggleButton Style="{StaticResource Tile}" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="⏻" FontSize="22" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="风扇强冷" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="▣" FontSize="20" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="摄像头" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}" IsChecked="True" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="⌁" FontSize="22" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="麦克风" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="⌘" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="Win键锁" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="▭" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="息屏" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="+" FontSize="24" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="自定义" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </ToggleButton>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 显卡模式 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="▣  显卡模式" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="GPU 73℃   90W   4698rpm 100%" Style="{StaticResource StatText}" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,2,0,0">
                            <ToggleButton Content="核显模式" Style="{StaticResource BigSegment}" />
                            <ToggleButton Content="混合模式" Style="{StaticResource BigSegment}" />
                            <ToggleButton Content="独显直连" Style="{StaticResource BigSegment}" IsChecked="True" Margin="0" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- 屏幕 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="▭  屏幕" Style="{StaticResource SectionHeader}" Margin="0" />
                            <CheckBox Content="自动刷新率" Style="{StaticResource RowSwitch}" HorizontalAlignment="Right" FontSize="13" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <ToggleButton Content="180" Style="{StaticResource BigSegment}" IsChecked="True" />
                            <ToggleButton Content="60" Style="{StaticResource BigSegment}" Margin="0" />
                        </UniformGrid>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度" Style="{StaticResource StatText}" Margin="0,0,12,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="100" />
                            <TextBlock Grid.Column="2" Text="100%" Style="{StaticResource StatText}" Margin="10,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="屏幕校色" Style="{StaticResource StatText}" Margin="0,0,14,0" />
                            <CheckBox Grid.Column="1" Content="默认" Style="{StaticResource RowSwitch}" />
                            <Button Grid.Column="2" Content="设置" Style="{StaticResource MiniButton}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="色彩增强" Style="{StaticResource StatText}" Margin="0,0,14,0" />
                            <CheckBox Grid.Column="1" Content="关" Style="{StaticResource RowSwitch}" />
                            <Button Grid.Column="2" Content="编辑" Style="{StaticResource MiniButton}" />
                        </Grid>
                    </StackPanel>

                    <!-- 电池 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="▭  电池" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="圆口 230/240W · 已充满" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <ToggleButton Content="长效模式" Style="{StaticResource BigSegment}" IsChecked="True" />
                            <ToggleButton Content="平衡模式" Style="{StaticResource BigSegment}" />
                            <ToggleButton Content="工作站模式" Style="{StaticResource BigSegment}" Margin="0" />
                        </UniformGrid>
                        <CheckBox Content="启用无极限充功能(实验性)" Style="{StaticResource RowSwitch}" />
                        <CheckBox Content="关闭 EC 直写充电上限（写入异常时用）" Style="{StaticResource RowSwitch}" />
                        <Slider Minimum="40" Maximum="100" Value="100" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 灯光 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="☀  灯光" Style="{StaticResource SectionHeader}" Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="自动关闭时间" Style="{StaticResource StatText}" Margin="0,0,10,0" />
                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="12,6">
                                    <TextBlock Text="关" FontSize="13" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="离电自动关闭全部灯效" Style="{StaticResource RowSwitch}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="键盘" Style="{StaticResource StatText}" />
                            <CheckBox Grid.Column="1" Content="单色" Style="{StaticResource RowSwitch}" />
                            <Button Grid.Column="2" Content="编辑" Style="{StaticResource MiniButton}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Logo 灯" Style="{StaticResource StatText}" />
                            <CheckBox Grid.Column="1" Content="单色" Style="{StaticResource RowSwitch}" />
                            <Button Grid.Column="2" Content="编辑" Style="{StaticResource MiniButton}" />
                        </Grid>
                    </StackPanel>

                    <!-- 更多开关 -->
                    <StackPanel Style="{StaticResource Section}" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="‹›  更多开关" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="15/31 开启" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部 dock：模仿原版悬浮底栏 -->
            <Border Grid.Row="3" Background="#AA10141B" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="0.293.5 / WPF P0" FontSize="12" />
                        <TextBlock Text="缩略图 / 设置 / 赞助 / 诊断 / 退出" Style="{StaticResource MutedText}" FontSize="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="悬浮窗" Style="{StaticResource GhostButton}" FontSize="11" Padding="9,6" Margin="0,0,5,0" />
                        <Button Content="设置" Style="{StaticResource GhostButton}" FontSize="11" Padding="9,6" Margin="0,0,5,0" />
                        <Button Content="诊断" Style="{StaticResource GhostButton}" FontSize="11" Padding="9,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
