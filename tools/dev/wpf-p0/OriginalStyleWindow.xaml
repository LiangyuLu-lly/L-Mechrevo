                        <Grid x:Name="LogoLightRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:WpfStrings.OriginalStyleWindow_Text_3}" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LogoLightSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LogoLightSwitch_Click" />
                            <ComboBox x:Name="LogoEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LogoEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LogoLightEditButton" Grid.Column="3" Content="{x:Static loc:WpfStrings.LightSyncEditButton_Content}" Style="{StaticResource MiniButton}" Click="LogoLightEdit_Click" />
                        </Grid>
                        <Grid x:Name="LightHingeRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:WpfStrings.OriginalStyleWindow_Text_2}" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LightHingeSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LightHingeSwitch_Click" />
                            <ComboBox x:Name="LightHingeEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LightHingeEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LightHingeEditButton" Grid.Column="3" Content="{x:Static loc:WpfStrings.LightSyncEditButton_Content}" Style="{StaticResource MiniButton}" Click="LightHingeEdit_Click" />
                        </Grid>
                        <Grid x:Name="LightSyncRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:WpfStrings.OriginalStyleWindow_Text}" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LightSyncSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LightSyncSwitch_Click" />
                            <ComboBox x:Name="LightSyncEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LightSyncEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LightSyncEditButton" Grid.Column="3" Content="{x:Static loc:WpfStrings.LightSyncEditButton_Content}" Style="{StaticResource MiniButton}" Click="LightSyncEdit_Click" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- 更多开关 -->
                    <StackPanel x:Name="MoreSection" Style="{StaticResource Section}" Margin="0,0,0,10">
                        <Grid x:Name="MoreHeader" Cursor="Hand" MouseLeftButtonUp="MoreHeader_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MoreArrow" Text="▸" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{x:Static loc:WpfStrings.NavSwitches_Content}" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                            <TextBlock x:Name="MoreSwitchCount" Text="—" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                    <StackPanel x:Name="MoreGroupsPanel" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>

                </WrapPanel>
            </ScrollViewer>
            <ScrollBar x:Name="MainScrollBar" Grid.Row="3" Orientation="Vertical"
                       Style="{StaticResource OverlayScrollBar}" Width="8"
                       HorizontalAlignment="Right" VerticalAlignment="Stretch"
                       Margin="0,4,2,4" Visibility="Collapsed"
                       ValueChanged="MainScrollBar_ValueChanged" />

            <!-- 底部 dock：模仿原版悬浮底栏 -->
            <Border Grid.Row="4" Margin="12,0,12,8" Background="{DynamicResource DockBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock x:Name="StatusText" Text="0.293.6" FontSize="12" />
                        <TextBlock Text="beta23.6" Style="{StaticResource MutedText}" FontSize="10" />
                    </StackPanel>
                    <UniformGrid Grid.Column="1" Columns="6" VerticalAlignment="Center">
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="悬浮窗">
                            <StackPanel>
                                <Rectangle Width="15" Height="15" HorizontalAlignment="Center" Fill="{DynamicResource MutedBrush}">
                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/Icons/ui-overlay.png" /></Rectangle.OpacityMask>
                    </Rectangle>
                                <TextBlock Text="{x:Static loc:WpfStrings.MainWindow_Text_4}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="检查更新">
                            <StackPanel>
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{x:Static loc:WpfStrings.CheckUpdateButton_Content}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="设置">
                            <StackPanel>
                                <Rectangle Width="15" Height="15" HorizontalAlignment="Center" Fill="{DynamicResource MutedBrush}">
                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/Icons/ui-settings.png" /></Rectangle.OpacityMask>
                    </Rectangle>
                                <TextBlock Text="{x:Static loc:WpfStrings.InlineOverlayTitle_Text}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="赞助">
                            <StackPanel>
                                <Rectangle Width="15" Height="15" HorizontalAlignment="Center" Fill="{DynamicResource MutedBrush}">
                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/Icons/ui-donate.png" /></Rectangle.OpacityMask>
                    </Rectangle>
                                <TextBlock Text="{x:Static loc:WpfStrings.MainWindow_Text_3}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="诊断">
                            <StackPanel>
                                <Rectangle Width="15" Height="15" HorizontalAlignment="Center" Fill="{DynamicResource MutedBrush}">
                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/Icons/ui-diag.png" /></Rectangle.OpacityMask>
                    </Rectangle>
                                <TextBlock Text="{x:Static loc:WpfStrings.MainWindow_Text_2}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="退出">
                            <StackPanel>
                                <Rectangle Width="15" Height="15" HorizontalAlignment="Center" Fill="{DynamicResource MutedBrush}">
                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/Icons/ui-quit.png" /></Rectangle.OpacityMask>
                    </Rectangle>
                                <TextBlock Text="{x:Static loc:WpfStrings.MainWindow_Text}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
