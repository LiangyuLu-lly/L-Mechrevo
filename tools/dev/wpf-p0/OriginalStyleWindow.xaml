<Window x:Class="L_Mechrevo.WpfP0.OriginalStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L-Mechrevo · 原版小窗 P0"
        Width="420" Height="720"
        MinWidth="420" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="StatText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BigSegment" TargetType="ToggleButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowSwitch" TargetType="CheckBox" BasedOn="{StaticResource SwitchBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
        <Style x:Key="ModeSegment" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 原版风格：圆角细滚动条（只用于本小窗） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource MutedBrush}" Opacity="0.65" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedBrush}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallSegment" TargetType="ToggleButton" BasedOn="{StaticResource BigSegment}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.58" />
        <Rectangle x:Name="BackgroundScrim" Fill="#99000000" Opacity="0.45" />

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部状态：模仿原版「GCU 已连接」 -->
            <Grid Grid.Row="0" Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="GCU 已连接" Foreground="#4ADE80" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="宽屏" Style="{StaticResource GhostButton}" FontSize="12" Padding="10,6" Click="WideButton_Click" Margin="0,0,6,0" />
                    <Button x:Name="ThemeButton" Content="浅色" Style="{StaticResource GhostButton}" FontSize="12" Padding="10,6" Click="ThemeButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" CanContentScroll="False" Background="Transparent">
                <StackPanel x:Name="ContentPanel" Margin="16,0,6,10" HorizontalAlignment="Left">

                    <!-- 性能模式 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◔  " Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="性能模式" Style="{StaticResource SectionHeader}" Margin="0" />
                                <CheckBox Content="GPU 超频" Style="{StaticResource RowSwitch}" Margin="18,0,0,0" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="CPU 85℃   52W   4427rpm 100%" Style="{StaticResource StatText}" />
                        </Grid>
                        <UniformGrid x:Name="ModeGrid" Columns="4" Margin="0,2,0,0">
                            <ToggleButton Content="静音" Tag="#22C55E" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" />
                            <ToggleButton Content="平衡" Tag="#3B82F6" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" />
                            <ToggleButton Content="静音狂暴" Tag="#F59E0B" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" />
                            <ToggleButton Content="高能狂暴" Tag="#EF4444" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" Margin="0" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- 快捷开关 -->
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="⚙  快捷开关" Style="{StaticResource SectionHeader}" />
                        <UniformGrid Columns="6" Rows="1">
                            <ToggleButton Style="{StaticResource Tile}" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="⏻" FontSize="15" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="强冷" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="▣" FontSize="14" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="摄像头" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}" IsChecked="True" >
                                <StackPanel>
                                    <TextBlock Text="⌁" FontSize="15" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="麦克风" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="⌘" FontSize="14" HorizontalAlignment="Center" />
                                    <TextBlock Text="Win键" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="▭" FontSize="14" HorizontalAlignment="Center" />
                                    <TextBlock Text="息屏" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Tile}" >
                                <StackPanel>
                                    <TextBlock Text="+" FontSize="20" HorizontalAlignment="Center" Foreground="#F87171" />
                                    <TextBlock Text="自定义" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </ToggleButton>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 显卡模式 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="▣  显卡模式" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="GPU 73℃   90W   4698rpm 100%" Style="{StaticResource StatText}" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,2,0,0">
                            <ToggleButton Content="核显模式" Style="{StaticResource SmallSegment}" />
                            <ToggleButton Content="混合模式" Style="{StaticResource SmallSegment}" />
                            <ToggleButton Content="独显直连" Style="{StaticResource SmallSegment}" IsChecked="True" Margin="0" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- 屏幕 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="▭  屏幕" Style="{StaticResource SectionHeader}" Margin="0" />
                            <CheckBox Content="自动刷新率" Style="{StaticResource RowSwitch}" HorizontalAlignment="Right" FontSize="13" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <ToggleButton Content="180" Style="{StaticResource SmallSegment}" IsChecked="True" />
                            <ToggleButton Content="60" Style="{StaticResource SmallSegment}" Margin="0" />
                        </UniformGrid>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度" Style="{StaticResource StatText}" Margin="0,0,12,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="100" Style="{StaticResource RoundSlider}" />
                            <TextBlock Grid.Column="2" Text="100%" Style="{StaticResource StatText}" Margin="10,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="屏幕校色" Style="{StaticResource StatText}" Margin="0,0,14,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="默认" />
                                <ComboBoxItem Content="sRGB" />
                                <ComboBoxItem Content="DCI-P3" />
                            </ComboBox>
                            <Button Grid.Column="2" Content="设置" Style="{StaticResource MiniButton}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="色彩增强" Style="{StaticResource StatText}" Margin="0,0,14,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="关" />
                                <ComboBoxItem Content="标准" />
                                <ComboBoxItem Content="鲜艳" />
                            </ComboBox>
                            <Button Grid.Column="2" Content="编辑" Style="{StaticResource MiniButton}" />
                        </Grid>
                    </StackPanel>

                    <!-- 电池 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="▭  电池" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="圆口 230/240W · 已充满" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <ToggleButton Content="长效模式" Style="{StaticResource SmallSegment}" IsChecked="True" />
                            <ToggleButton Content="平衡模式" Style="{StaticResource SmallSegment}" />
                            <ToggleButton Content="工作站模式" Style="{StaticResource SmallSegment}" Margin="0" />
                        </UniformGrid>
                        <CheckBox Content="启用无极限充功能(实验性)" Style="{StaticResource RowSwitch}" />
                        <CheckBox Content="关闭 EC 直写充电上限（写入异常时用）" Style="{StaticResource RowSwitch}" />
                        <Slider Minimum="40" Maximum="100" Value="100" Margin="0,8,0,0" Style="{StaticResource RoundSlider}" />
                    </StackPanel>

                    <!-- 灯光 -->
                    <StackPanel Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="☀  灯光" Style="{StaticResource SectionHeader}" Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="自动关闭时间" Style="{StaticResource StatText}" Margin="0,0,10,0" />
                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="12,6">
                                    <TextBlock Text="关" FontSize="13" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="离电自动关闭全部灯效" Style="{StaticResource RowSwitch}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="键盘" Style="{StaticResource StatText}" />
                            <CheckBox Grid.Column="1" Content="单色" Style="{StaticResource RowSwitch}" />
                            <Button Grid.Column="2" Content="编辑" Style="{StaticResource MiniButton}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Logo 灯" Style="{StaticResource StatText}" />
                            <CheckBox Grid.Column="1" Content="单色" Style="{StaticResource RowSwitch}" />
                            <Button Grid.Column="2" Content="编辑" Style="{StaticResource MiniButton}" />
                        </Grid>
                    </StackPanel>

                    <!-- 更多开关 -->
                    <StackPanel Style="{StaticResource Section}" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="‹›  更多开关" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="15/31 开启" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部 dock：模仿原版悬浮底栏 -->
            <Border Grid.Row="3" Margin="16,0,16,10" Background="#AA10141B" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="0.293.5 / WPF P0" FontSize="12" />
                        <TextBlock Text="缩略图 / 设置 / 赞助 / 诊断 / 退出" Style="{StaticResource MutedText}" FontSize="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="悬浮窗" Style="{StaticResource GhostButton}" FontSize="11" Padding="9,6" Margin="0,0,5,0" />
                        <Button Content="设置" Style="{StaticResource GhostButton}" FontSize="11" Padding="9,6" Margin="0,0,5,0" />
                        <Button Content="诊断" Style="{StaticResource GhostButton}" FontSize="11" Padding="9,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
