                            <Button Grid.Column="4" Content="恢复默认" Style="{StaticResource MiniButton}" Click="XingyaoChargeRestore_Click" />
                        </Grid>
                        <StackPanel x:Name="XingyaoChargeButtonRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static loc:WpfStrings.OriginalStyleWindow_Text_11}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="XingyaoChargeLowBox" Width="56" Height="26" VerticalContentAlignment="Center" Text="85" Margin="0,0,10,0" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="5,0" />
