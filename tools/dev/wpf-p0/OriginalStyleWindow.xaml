<Window x:Class="L_Mechrevo.WpfP0.OriginalStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:L_Mechrevo.WpfP0"
        Title="L-Mechrevo · 原版小窗 P0"
        Icon="Assets/Icons/app.png"
        Width="420" Height="560"
        MinWidth="420" MaxWidth="420" MinHeight="300"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontBoldFamily}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="StatText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource StatText}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="BigSegment" TargetType="ToggleButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowSwitch" TargetType="CheckBox" BasedOn="{StaticResource SwitchBox}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="52" />
                <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
</Style>
        <Style x:Key="ModeSegment" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontFamily" Value="{DynamicResource AppFontBoldFamily}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 原版风格：圆角细滚动条（只用于本小窗） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource MutedBrush}" Opacity="0.65" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                            <ContentPresenter Margin="7,0,20,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 3 3 L 6 0" Stroke="{DynamicResource MutedBrush}"
                                                  StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Margin="0,3,0,0" Padding="3"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
                <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
</Style>

        <Style x:Key="SmallSegment" TargetType="ToggleButton" BasedOn="{StaticResource BigSegment}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="32" Height="18" CornerRadius="9"
                                    Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,1,0,0" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,1,1,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
                <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
</Style>

        <Style x:Key="GpuSegment" TargetType="ToggleButton" BasedOn="{StaticResource SmallSegment}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="RefreshSegment" TargetType="ToggleButton" BasedOn="{StaticResource SmallSegment}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="BatterySegment" TargetType="ToggleButton" BasedOn="{StaticResource SmallSegment}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="10" />
        </Style>

    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.58" Visibility="Collapsed" />
        <Rectangle x:Name="BackgroundScrim" Fill="#99000000" Opacity="0.45" Visibility="Collapsed" />

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏：标题 + 关闭 -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="TitleIconImage" Source="Assets/Icons/app.png" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="L-Mechrevo · 原版小窗" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="TitleCloseButton" Content="✕" Width="44" Height="34" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                        FontSize="14" Cursor="Hand" Click="TitleClose_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 顶部状态：模仿原版「GCU 已连接」 -->
            <Grid Grid.Row="1" Margin="12,8,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BackendStatus" Text="● GCU 状态未知" Foreground="#9BA6B5" FontSize="12" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="BackendStatus_MouseLeftButtonUp" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WideButton" Content="宽屏" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,4" Click="WideButton_Click" Margin="0,0,6,0" />
                    <Button x:Name="ThemeButton" Content="浅色" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,4" Click="ThemeButton_Click" Margin="0,0,6,0" />
                    <CheckBox x:Name="BackgroundToggle" Content="背景图" Style="{StaticResource HeaderSwitch}" FontSize="10" Margin="0,0,0,0" VerticalAlignment="Center"
                              Checked="BackgroundToggle_Changed" Unchecked="BackgroundToggle_Changed" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="MainScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" CanContentScroll="False" Background="Transparent">
                <WrapPanel x:Name="ContentPanel" Margin="12,0,5,8" HorizontalAlignment="Left" Orientation="Horizontal">

                    <!-- 性能模式 -->
                    <StackPanel x:Name="PerfSection" Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="性能模式" Style="{StaticResource SectionHeader}" Margin="0" />
                                <CheckBox x:Name="GpuOverclockSwitch" Content="GPU 超频" Style="{StaticResource HeaderSwitch}" Margin="14,0,0,0" VerticalAlignment="Center" Click="GpuOverclock_Click" />
                                <Button x:Name="PerfConfigEditButton" Content="配置编辑" Style="{StaticResource MiniButton}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="PerfConfigEdit_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentModeText" Text="当前：—" Style="{StaticResource StatText}" Margin="0,0,10,0" />
                                <TextBlock x:Name="CpuStat" Text="CPU —" Style="{StaticResource StatText}" />
                            </StackPanel>
                        </Grid>
                        <local:AdaptivePanel x:Name="ModeGrid" Margin="0,2,0,0">
                            <ToggleButton x:Name="SilentModeButton" Tag="#22C55E" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" >
                                <TextBlock Text="静音" Height="18" VerticalAlignment="Center" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                                           FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                            <ToggleButton x:Name="BalancedModeButton" Tag="#3B82F6" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" >
                                <TextBlock Text="平衡" Height="18" VerticalAlignment="Center" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                                           FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                            <ToggleButton x:Name="TurboModeButton" Tag="#EF4444" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" >
                                <TextBlock Text="狂暴" Height="18" VerticalAlignment="Center" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                                           FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                            <ToggleButton x:Name="CustomModeButton" Tag="#A78BFA" Style="{StaticResource ModeSegment}" Click="ModeButton_Click" MouseRightButtonUp="CustomModeButton_MouseRightButtonUp" Margin="0" >
                                <TextBlock Text="自定义" Height="18" VerticalAlignment="Center" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                                           FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                        </local:AdaptivePanel>
                        <Grid x:Name="PerfConfigRow" Margin="0,4,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="静音" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="PerfConfigSilentCombo" Style="{StaticResource RoundCombo}" Tag="2" SelectionChanged="PerfConfig_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="平衡" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="PerfConfigBalancedCombo" Style="{StaticResource RoundCombo}" Tag="0" SelectionChanged="PerfConfig_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="2">
                                <TextBlock Text="狂暴" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="PerfConfigTurboCombo" Style="{StaticResource RoundCombo}" Tag="1" SelectionChanged="PerfConfig_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="BackendLine" Visibility="Collapsed" />

                    <!-- 快捷开关 -->
                    <StackPanel x:Name="QuickSection" Style="{StaticResource Section}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="快捷开关" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                        <local:AdaptivePanel x:Name="QuickTileGrid" AllowDrop="True">
                            <ToggleButton x:Name="FanTile" Style="{StaticResource Tile}" Tag="fanboost" Click="QuickTile_Click" IsChecked="True">
                                <StackPanel>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              Data="M8,8 C6,5 6,2 8,1 C10,2 10,5 8,8 Z M8,8 C11,6 14,7 15,9 C13,11 10,10 8,8 Z M8,8 C10,11 10,14 8,15 C6,14 6,11 8,8 Z M8,8 C5,10 2,9 1,7 C3,5 6,6 8,8 Z M8,7 A1,1 0 1 1 8,9 A1,1 0 1 1 8,7 Z" />
                                    </Canvas>
                                </Viewbox>
                                    <TextBlock Text="强冷" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="CameraTile" Style="{StaticResource Tile}" Tag="webcam" Click="QuickTile_Click" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="摄像头" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="MicTile" Style="{StaticResource Tile}" Tag="micmute" Click="QuickTile_Click">
                                <StackPanel>
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="麦克风" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="WinKeyTile" Style="{StaticResource Tile}" Tag="winkey" Click="QuickTile_Click">
                                <StackPanel>
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="Win键锁" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ScreenOffTile" Style="{StaticResource Tile}" Tag="monitoroff" Click="QuickTile_Click">
                                <StackPanel>
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="息屏" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="CustomTile" Style="{StaticResource Tile}" Click="CustomTile_Click">
                                <StackPanel>
                                    <TextBlock x:Name="CustomTileIcon" Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock x:Name="CustomTileLabel" Text="自定义" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                        </local:AdaptivePanel>
                    </StackPanel>

                    <!-- 显卡模式 -->
                    <StackPanel x:Name="GpuSection" Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              Data="M3,5 H21 V17 H3 Z M5,8 H9 M5,11 H9 M13.5,8 A3.5,3.5 0 1 0 13.5,15 A3.5,3.5 0 0 0 13.5,8 M7,17 V20 H17 V17" />
                                    </Canvas>
                                </Viewbox><TextBlock Text="显卡模式" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                            <TextBlock x:Name="GpuStat" Grid.Column="1" Text="GPU —" Style="{StaticResource StatText}" />
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="GpuEcoColumn" Width="*" />
                                <ColumnDefinition x:Name="GpuHybridColumn" Width="*" />
                                <ColumnDefinition x:Name="GpuDirectColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="GpuEcoButton" Grid.Column="0" Content="核显模式" Tag="0" Style="{StaticResource GpuSegment}" Click="GpuMode_Click" />
                            <ToggleButton x:Name="GpuHybridButton" Grid.Column="1" Content="混合模式" Tag="1" Style="{StaticResource GpuSegment}" Click="GpuMode_Click" />
                            <ToggleButton x:Name="GpuDirectButton" Grid.Column="2" Content="独显直连" Tag="2" Style="{StaticResource GpuSegment}" IsChecked="True" Click="GpuMode_Click" Margin="0" />
                        </Grid>
                    </StackPanel>

                    <!-- 屏幕 -->
                    <StackPanel x:Name="ScreenSection" Style="{StaticResource Section}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="屏幕" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                            <CheckBox x:Name="AutoRefreshSwitch" Content="自动刷新率" Style="{StaticResource HeaderSwitch}" HorizontalAlignment="Right" Click="AutoRefresh_Click" />
                        </Grid>
                        <local:AdaptivePanel Margin="0,0,0,6">
                            <ToggleButton x:Name="Refresh180Button" Content="180" Style="{StaticResource RefreshSegment}" Tag="180" Click="RefreshRate_Click" IsChecked="True" />
                            <ToggleButton x:Name="Refresh60Button" Content="60" Style="{StaticResource RefreshSegment}" Tag="60" Click="RefreshRate_Click" Margin="0" />
                        </local:AdaptivePanel>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" Style="{StaticResource RoundSlider}" ValueChanged="Brightness_Changed" />
                            <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="100%" Style="{StaticResource StatText}" Margin="10,0,0,0" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="屏幕校色" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                            <CheckBox x:Name="CalibrationSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,10,0" VerticalAlignment="Center" Click="CalibrationSwitch_Click" />
                            <ComboBox x:Name="CalibrationCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="CalibrationCombo_SelectionChanged">
                                <ComboBoxItem Content="默认" />
                                <ComboBoxItem Content="sRGB" />
                                <ComboBoxItem Content="DCI-P3" />
                            </ComboBox>
                            <Button x:Name="CalibrationSettingsButton" Grid.Column="3" Content="设置" Style="{StaticResource MiniButton}" Click="CalibrationSettings_Click" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="色彩增强" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                            <CheckBox x:Name="DisplayEffectSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,10,0" VerticalAlignment="Center" Click="DisplayEffectSwitch_Click" />
                            <ComboBox x:Name="DisplayEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0">
                                <ComboBoxItem Content="关" />
                                <ComboBoxItem Content="标准" />
                                <ComboBoxItem Content="鲜艳" />
                            </ComboBox>
                            <Button x:Name="DisplayEffectEditButton" Grid.Column="3" Content="编辑" Style="{StaticResource MiniButton}" Click="DisplayEffectEdit_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- 电池 -->
                    <StackPanel x:Name="BatterySection" Style="{StaticResource Section}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="电池" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                            <TextBlock x:Name="BatteryInfo" Text="电池 —" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                        <local:AdaptivePanel Margin="0,0,0,10">
                            <ToggleButton x:Name="BatteryLongButton" Content="长效模式" Style="{StaticResource BatterySegment}" Tag="0" Click="BatteryMode_Click" IsChecked="True" />
                            <ToggleButton x:Name="BatteryBalancedButton" Content="平衡模式" Style="{StaticResource BatterySegment}" Tag="1" Click="BatteryMode_Click" />
                            <ToggleButton x:Name="BatteryWorkButton" Content="工作站模式" Style="{StaticResource BatterySegment}" Tag="2" Click="BatteryMode_Click" Margin="0" />
                        </local:AdaptivePanel>
                        <Grid x:Name="ChargeLimitRow" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="限制充电" Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                            <CheckBox x:Name="ChargeLimitSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" VerticalAlignment="Center" Click="ChargeLimitSwitch_Click" />
                            <Button x:Name="ChargeLimitApplyButton" Grid.Column="3" Content="保存阈值" Style="{StaticResource MiniButton}" Click="ChargeLimitApply_Click" />
                        </Grid>
                        <Grid x:Name="ChargeLimitInputRow" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="起充 %" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                                <TextBox x:Name="ChargeLimitLowBox" Text="60" Width="72" Height="26" HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center" Background="{DynamicResource InputBrush}"
                                         Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                         BorderThickness="1" Padding="6,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="停充 %" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                                <TextBox x:Name="ChargeLimitHighBox" Text="80" Width="72" Height="26" HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center" Background="{DynamicResource InputBrush}"
                                         Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                         BorderThickness="1" Padding="6,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ChargeLimitStatus" Text="读取充电阈值状态…" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                        <CheckBox x:Name="ChargeSliderToggle" Content="启用无极限充功能(实验性)" Style="{StaticResource RowSwitch}" Click="ChargeSliderToggle_Click" />
                        <CheckBox x:Name="EcDirectOffToggle" Content="关闭 EC 直写充电上限（写入异常时用）" Style="{StaticResource RowSwitch}" Click="EcDirectOffToggle_Click" />
                        <Slider x:Name="BatteryLimitSlider" Minimum="40" Maximum="100" Value="100" Margin="0,8,0,0" Style="{StaticResource RoundSlider}" ValueChanged="BatteryLimitSlider_Changed" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- 水冷 -->
                    <StackPanel x:Name="LiquidSection" Style="{StaticResource Section}" Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="水冷系统" Style="{StaticResource SectionHeader}" Margin="0" />
                            </StackPanel>
                            <Button x:Name="LiquidStatusButton" Content="未连接" Style="{StaticResource MiniButton}" HorizontalAlignment="Right" Click="LiquidStatus_Click" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="水泵" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LiquidPumpCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="LiquidPump_SelectionChanged">
                                <ComboBoxItem Content="自动" Tag="-1" />
                                <ComboBoxItem Content="45%" Tag="0" />
                                <ComboBoxItem Content="60%" Tag="1" />
                                <ComboBoxItem Content="90%" Tag="2" />
                            </ComboBox>
                            <TextBlock Text="风扇" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LiquidFanCombo" Grid.Column="3" Style="{StaticResource RoundCombo}" SelectedIndex="0" SelectionChanged="LiquidFan_SelectionChanged">
                                <ComboBoxItem Content="自动" Tag="-1" />
                                <ComboBoxItem Content="40%" Tag="0" />
                                <ComboBoxItem Content="50%" Tag="1" />
                                <ComboBoxItem Content="60%" Tag="2" />
                                <ComboBoxItem Content="90%" Tag="3" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- 灯光 -->
                    <StackPanel x:Name="LightingSection" Style="{StaticResource Section}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="灯光" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="自动关闭时间" Style="{StaticResource StatText}" Margin="0,0,8,0" />
                                <ComboBox x:Name="LightIdleCombo" Width="96" Style="{StaticResource RoundCombo}" SelectionChanged="LightIdleCombo_SelectionChanged">
                                    <ComboBoxItem Content="关" Tag="0" />
                                    <ComboBoxItem Content="1 分钟" Tag="60" />
                                    <ComboBoxItem Content="5 分钟" Tag="300" />
                                    <ComboBoxItem Content="10 分钟" Tag="600" />
                                    <ComboBoxItem Content="30 分钟" Tag="1800" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="LightOffOnBatteryCheck" Content="离电自动关闭全部灯效" Style="{StaticResource RowSwitch}" Click="LightOffOnBattery_Click" />
                        <Grid x:Name="KeyboardLightRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="键盘" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="KeyboardLightSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="KeyboardLightSwitch_Click" />
                            <ComboBox x:Name="KeyboardEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" Margin="0,0,8,0" SelectionChanged="KeyboardEffectCombo_SelectionChanged" />
                            <Button x:Name="KeyboardLightEditButton" Grid.Column="3" Content="编辑" Style="{StaticResource MiniButton}" Click="KeyboardLightEdit_Click" />
                        </Grid>
                        <Grid x:Name="LightStripRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="灯带" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LightStripSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LightStripSwitch_Click" />
                            <ComboBox x:Name="LightStripEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LightStripEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LightStripEditButton" Grid.Column="3" Content="编辑" Style="{StaticResource MiniButton}" Click="LightStripEdit_Click" />
                        </Grid>
                        <Grid x:Name="LogoLightRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Logo 灯" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LogoLightSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LogoLightSwitch_Click" />
                            <ComboBox x:Name="LogoEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LogoEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LogoLightEditButton" Grid.Column="3" Content="编辑" Style="{StaticResource MiniButton}" Click="LogoLightEdit_Click" />
                        </Grid>
                        <Grid x:Name="LightHingeRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="铰链灯" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LightHingeSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LightHingeSwitch_Click" />
                            <ComboBox x:Name="LightHingeEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LightHingeEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LightHingeEditButton" Grid.Column="3" Content="编辑" Style="{StaticResource MiniButton}" Click="LightHingeEdit_Click" />
                        </Grid>
                        <Grid x:Name="LightSyncRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="同步灯" Style="{StaticResource RowLabel}" />
                            <CheckBox x:Name="LightSyncSwitch" Grid.Column="1" Style="{StaticResource HeaderSwitch}" Margin="0,0,8,0" VerticalAlignment="Center" Click="LightSyncSwitch_Click" />
                            <ComboBox x:Name="LightSyncEffectCombo" Grid.Column="2" Style="{StaticResource RoundCombo}" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LightSyncEffectCombo_SelectionChanged">
                            </ComboBox>
                            <Button x:Name="LightSyncEditButton" Grid.Column="3" Content="编辑" Style="{StaticResource MiniButton}" Click="LightSyncEdit_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- 更多开关 -->
                    <StackPanel x:Name="MoreSection" Style="{StaticResource Section}" Margin="0,0,0,10">
                        <Grid x:Name="MoreHeader" Cursor="Hand" MouseLeftButtonUp="MoreHeader_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MoreArrow" Text="▸" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="更多开关" Style="{StaticResource SectionHeader}" Margin="0" /></StackPanel>
                            <TextBlock x:Name="MoreSwitchCount" Text="—" Style="{StaticResource StatText}" HorizontalAlignment="Right" />
                        </Grid>
                    <StackPanel x:Name="MoreGroupsPanel" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>

                </WrapPanel>
            </ScrollViewer>

            <!-- 底部 dock：模仿原版悬浮底栏 -->
            <Border Grid.Row="4" Margin="12,0,12,8" Background="{DynamicResource DockBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock x:Name="StatusText" Text="0.293.5" FontSize="12" />
                        <TextBlock Text="beta23.5" Style="{StaticResource MutedText}" FontSize="10" />
                    </StackPanel>
                    <UniformGrid Grid.Column="1" Columns="5" VerticalAlignment="Center">
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="悬浮窗">
                            <StackPanel>
                                <Image Source="Assets/Icons/ui-overlay.png" Width="15" Height="15" HorizontalAlignment="Center" />
                                <TextBlock Text="悬浮窗" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="设置">
                            <StackPanel>
                                <Image Source="Assets/Icons/ui-settings.png" Width="15" Height="15" HorizontalAlignment="Center" />
                                <TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="赞助">
                            <StackPanel>
                                <Image Source="Assets/Icons/ui-donate.png" Width="15" Height="15" HorizontalAlignment="Center" />
                                <TextBlock Text="赞助" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="诊断">
                            <StackPanel>
                                <Image Source="Assets/Icons/ui-diag.png" Width="15" Height="15" HorizontalAlignment="Center" />
                                <TextBlock Text="诊断" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockButton}" Click="DockButton_Click" Tag="退出">
                            <StackPanel>
                                <Image Source="Assets/Icons/ui-quit.png" Width="15" Height="15" HorizontalAlignment="Center" />
                                <TextBlock Text="退出" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
