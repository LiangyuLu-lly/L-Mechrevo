<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.CpuTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.TitleText_Text}"
        Width="680" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{x:Static loc:WpfStrings.TitleText_Text}" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="CpuText" Text="" Style="{DynamicResource MutedText}" Margin="0,4,0,2" />
            <TextBlock x:Name="StatusText" Text="" Style="{DynamicResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsPanel" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="AutoApplyCheck" Content="{x:Static loc:WpfStrings.AutoApplyCheck_Content}" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Click="AutoApply_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content_4}" Style="{StaticResource FlatButton}" Click="SaveSnapshot_Click" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content_3}" Style="{StaticResource FlatButton}" Click="LoadSnapshot_Click" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content_2}" Style="{StaticResource FlatButton}" Click="Reset_Click" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content}" Style="{StaticResource FlatButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
