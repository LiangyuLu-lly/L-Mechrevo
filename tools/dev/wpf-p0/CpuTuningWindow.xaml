<Window x:Class="L_Mechrevo.WpfP0.CpuTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 调节"
        Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="CPU 调节" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="CpuText" Text="" Style="{DynamicResource MutedText}" Margin="0,4,0,2" />
            <TextBlock x:Name="StatusText" Text="" Style="{DynamicResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptionsPanel" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="AutoApplyCheck" Content="开机自动应用" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Click="AutoApply_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存快照" Style="{StaticResource FlatButton}" Click="SaveSnapshot_Click" Margin="0,0,8,0" />
                <Button Content="读取快照" Style="{StaticResource FlatButton}" Click="LoadSnapshot_Click" Margin="0,0,8,0" />
                <Button Content="高级选项" Style="{StaticResource FlatButton}" Click="Advanced_Click" Margin="0,0,8,0" />
                <Button Content="重置" Style="{StaticResource FlatButton}" Click="Reset_Click" Margin="0,0,8,0" />
                <Button Content="关闭" Style="{StaticResource FlatButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
