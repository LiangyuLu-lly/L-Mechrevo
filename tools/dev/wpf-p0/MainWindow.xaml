<Window x:Class="L_Mechrevo.WpfP0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="L-Mechrevo · WPF P0"
        Width="1180" Height="800"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/Icons/app.png">

    <Grid>
        <!-- P0：真实背景图（cover）+ 可调压暗层；卡片/控件全部半透明，滚动由 ScrollViewer 合成平移。 -->
        <Image x:Name="BackgroundImage" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.78" />
        <Rectangle x:Name="BackgroundScrim" Fill="#99000000" Opacity="0.35" />

        <Grid Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="L" FontSize="18" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="L-Mechrevo" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="WPF P0 · 背景图 / 半透明卡片 / 合成滚动 / 主题色" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="切换浅色" Style="{StaticResource GhostButton}" Click="ThemeButton_Click" Margin="0,6,10,6" />
                    <Border Background="#22000000" CornerRadius="10" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="强调色" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Tag="#3B82F6" Background="#3B82F6" Width="20" Height="20" BorderThickness="0" Cursor="Hand" Click="AccentButton_Click" Margin="2,0" />
                            <Button Tag="#22C55E" Background="#22C55E" Width="20" Height="20" BorderThickness="0" Cursor="Hand" Click="AccentButton_Click" Margin="2,0" />
                            <Button Tag="#F59E0B" Background="#F59E0B" Width="20" Height="20" BorderThickness="0" Cursor="Hand" Click="AccentButton_Click" Margin="2,0" />
                            <Button Tag="#EF4444" Background="#EF4444" Width="20" Height="20" BorderThickness="0" Cursor="Hand" Click="AccentButton_Click" Margin="2,0" />
                            <Button Tag="#A855F7" Background="#A855F7" Width="20" Height="20" BorderThickness="0" Cursor="Hand" Click="AccentButton_Click" Margin="2,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 左侧导航 + 主内容 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="导航" Style="{StaticResource MutedText}" Margin="2,0,0,10" />
                        <Button Content="仪表盘" Style="{StaticResource NavButton}" Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" />
                        <Button Content="性能模式" Style="{StaticResource NavButton}" />
                        <Button Content="显卡 / 显示" Style="{StaticResource NavButton}" />
                        <Button Content="电池" Style="{StaticResource NavButton}" />
                        <Button Content="风扇曲线" Style="{StaticResource NavButton}" />
                        <Button Content="灯光" Style="{StaticResource NavButton}" />
                        <Button Content="设置" Style="{StaticResource NavButton}" />
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="6,12,6,12" />
                        <TextBlock Text="P0 验证点" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6" />
                        <TextBlock Text="背景图 cover&#10;半透明卡片&#10;ScrollViewer 合成滚动&#10;主题色即时切换&#10;DPI / 字体" Style="{StaticResource MutedText}" LineHeight="19" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="2" x:Name="MainScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Background="Transparent"
                              Padding="0,0,4,0">
                    <StackPanel>

                        <!-- 性能模式 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="性能模式" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="分段按钮 + 强调色高亮，全部半透明叠在底图上" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="当前：平衡" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ToggleButton Content="平衡" Style="{StaticResource SegmentButton}" IsChecked="True" />
                                    <ToggleButton Content="狂暴" Style="{StaticResource SegmentButton}" />
                                    <ToggleButton Content="自定义" Style="{StaticResource SegmentButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 快捷开关 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="快捷开关" Style="{StaticResource SectionTitle}" />
                                <UniformGrid Columns="2" Rows="2" Margin="0,12,0,0">
                                    <CheckBox Content="无线网络" Style="{StaticResource SwitchBox}" IsChecked="True" Margin="0,6,10,6" />
                                    <CheckBox Content="蓝牙" Style="{StaticResource SwitchBox}" IsChecked="True" Margin="0,6,10,6" />
                                    <CheckBox Content="摄像头" Style="{StaticResource SwitchBox}" Margin="0,6,10,6" />
                                    <CheckBox Content="麦克风" Style="{StaticResource SwitchBox}" Margin="0,6,0,6" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 显卡 + 显示 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="显卡" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="NVIDIA GeForce RTX 4060 Laptop" Style="{StaticResource MutedText}" Margin="0,3,0,14" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU 温度" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="54 ℃" FontWeight="SemiBold" />
                                    </Grid>
                                    <ProgressBar Height="7" Minimum="0" Maximum="100" Value="38" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显存占用" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="2.1 / 8 GB" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="显示" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="2560 × 1600 · 165 Hz" Style="{StaticResource MutedText}" Margin="0,3,0,14" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="刷新率" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1" Text="165 Hz" FontWeight="SemiBold" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ToggleButton Content="60" Style="{StaticResource SegmentButton}" Padding="14,7" />
                                        <ToggleButton Content="120" Style="{StaticResource SegmentButton}" Padding="14,7" />
                                        <ToggleButton Content="165" Style="{StaticResource SegmentButton}" Padding="14,7" IsChecked="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 电池 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="电池" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Grid.Column="1" Text="82% · 正在充电" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="40" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="80%" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <CheckBox Content="限制充电上限" Style="{StaticResource SwitchBox}" IsChecked="True" Margin="0,0,24,0" />
                                    <CheckBox Content="无界电池电压修复(实验性)" Style="{StaticResource SwitchBox}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 风扇曲线 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="风扇曲线" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Grid.Column="1" Text="CPU 30% · GPU 30%" Style="{StaticResource MutedText}" />
                                </Grid>
                                <Border Height="150" Margin="0,14,0,0" Background="#18000000" CornerRadius="10" ClipToBounds="True">
                                    <Canvas x:Name="FanCanvas" Background="Transparent">
                                        <Polyline Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                                  Points="20,120 120,105 220,80 320,48 420,30 520,20 620,16" />
                                        <Polyline Stroke="#66FFFFFF" StrokeThickness="1.5"
                                                  Points="20,125 120,110 220,96 320,80 420,62 520,48 620,40" />
                                    </Canvas>
                                </Border>
                                <TextBlock Text="拖拽点、温度轴与闭环状态在 P1 接入" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 外观设置：验证动态主题/背景 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="外观（P0 验证）" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景图不透明度" />
                                    <TextBlock Grid.Column="1" x:Name="BackgroundOpacityLabel" Text="62%" Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" Value="62" Margin="0,6,0,12"
                                        ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="内容压暗" />
                                    <TextBlock Grid.Column="1" x:Name="ScrimLabel" Text="60%" Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="ScrimSlider" Minimum="0" Maximum="100" Value="60" Margin="0,6,0,0"
                                        ValueChanged="ScrimSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="P0 原型：WPF 视觉树 + Image(cover) + 半透明 Border + ScrollViewer 平移；逻辑库/硬件层尚未接入。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,2,18" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底栏 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="L-Mechrevo WPF P0 · 滚动 / 背景 / 主题验证" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="仅原型，不替代 WinForms 版本" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Window>
