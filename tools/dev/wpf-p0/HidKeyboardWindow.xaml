<Window x:Class="L_Mechrevo.WpfP0.HidKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="键盘灯效"
        Width="500" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="键盘灯效" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="HID 直连键盘：效果、电源与亮度。" Style="{DynamicResource MutedText}" Margin="0,4,0,10" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="效果" VerticalAlignment="Center" />
            <ComboBox x:Name="EffectCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectionChanged="Effect_Changed" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="电源" VerticalAlignment="Center" />
            <CheckBox x:Name="PowerCheck" Grid.Column="1" Style="{DynamicResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Text="关闭后停止 HID 效果" Style="{DynamicResource MutedText}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
            <TextBlock Text="亮度" VerticalAlignment="Center" />
            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="1" Maximum="100" Value="100" />
            <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="100%" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="4">
            <Grid x:Name="ColorRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="颜色" VerticalAlignment="Center" />
                <Button x:Name="ColorButton" Grid.Column="1" Content="选择颜色" Style="{StaticResource FlatButton}" Click="Color_Click" />
            </Grid>
            <Grid x:Name="SpeedRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="速度" VerticalAlignment="Center" />
                <Slider x:Name="SpeedSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="1" Maximum="10" Value="5" ValueChanged="Speed_Changed" />
                <TextBlock x:Name="SpeedText" Grid.Column="2" Text="5" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="AngleRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="角度" VerticalAlignment="Center" />
                <Slider x:Name="AngleSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="360" Value="30" ValueChanged="Angle_Changed" />
                <TextBlock x:Name="AngleText" Grid.Column="2" Text="30°" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="FpsRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="帧率" VerticalAlignment="Center" />
                <ComboBox x:Name="FpsCombo" Grid.Column="1" Width="110" Style="{StaticResource RoundCombo}" HorizontalAlignment="Left">
                    <ComboBoxItem Content="15 FPS" Tag="15" />
                    <ComboBoxItem Content="30 FPS" Tag="30" />
                    <ComboBoxItem Content="45 FPS" Tag="45" />
                    <ComboBoxItem Content="60 FPS" Tag="60" />
                </ComboBox>
            </Grid>
            <Grid x:Name="Extra1Row" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Extra1Label" Text="附加" VerticalAlignment="Center" />
                <Slider x:Name="Extra1Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="Extra1_Changed" />
                <TextBlock x:Name="Extra1Text" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="Extra2Row" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Extra2Label" Text="附加" VerticalAlignment="Center" />
                <Slider x:Name="Extra2Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="Extra2_Changed" />
                <TextBlock x:Name="Extra2Text" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="ColorCountRow" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ColorCountLabel" Text="颜色数" VerticalAlignment="Center" />
                <Slider x:Name="ColorCountSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="1" Maximum="5" Value="1" ValueChanged="ColorCount_Changed" />
                <TextBlock x:Name="ColorCountText" Grid.Column="2" Text="1" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="MultiColorPanel" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="MultiColorLabel" Text="颜色" Style="{DynamicResource MutedText}" Margin="0,0,0,4" />
                <UniformGrid x:Name="MultiColorGrid" Columns="5" />
            </StackPanel>
            <Grid x:Name="Extra3Row" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Extra3Label" Text="附加" VerticalAlignment="Center" />
                <Slider x:Name="Extra3Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="Extra3_Changed" />
                <TextBlock x:Name="Extra3Text" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <CheckBox x:Name="ExtraCheck" Content="附加选项" Style="{DynamicResource HeaderSwitch}" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText" Style="{DynamicResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Top" />
        </StackPanel>
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="应用" Style="{StaticResource FlatButton}" Click="Apply_Click" Margin="0,0,8,0" />
                <Button Content="关闭" Style="{StaticResource FlatButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
