<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.OverlayWindow_Title}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        Icon="Assets/Icons/app.png">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F5F8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#C3CAD4" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#33FFFFFF" />
    </Window.Resources>
    <Grid x:Name="OverlayRoot" Background="Transparent"
          MouseEnter="OverlayRoot_MouseEnter" MouseLeave="OverlayRoot_MouseLeave">
    <Border x:Name="OverlayCard" Background="#E60B0D10" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="10,5">
        <StackPanel Grid.IsSharedSizeScope="True">
            <Grid x:Name="GpuRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol0" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol1" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol2" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol3" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol4" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol5" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol6" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol7" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol8" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GpuLabel" Text="GPU:" Foreground="#22C55E" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuTempText" Grid.Column="1" Text="—" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuFreqText" Grid.Column="2" Text="—" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuFanText" Grid.Column="3" Text="—" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuPowerText" Grid.Column="4" Text="—" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuUsageText" Grid.Column="5" Text="—" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar x:Name="GpuUsageBar" Grid.Column="6" Width="30" Height="7" Margin="4,0,0,0" Minimum="0" Maximum="100"
                             Foreground="#22C55E" Background="#33FFFFFF" BorderThickness="0" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuMemoryText" Grid.Column="7" Text="—" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar x:Name="GpuMemoryBar" Grid.Column="8" Width="30" Height="7" Margin="4,0,0,0" Minimum="0" Maximum="100"
                             Foreground="#22C55E" Background="#33FFFFFF" BorderThickness="0" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="CpuRow" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol0" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol1" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol2" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol3" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol4" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol5" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol6" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol7" /><ColumnDefinition Width="Auto" SharedSizeGroup="OverlayCol8" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CpuLabel" Text="CPU:" Foreground="#22D3EE" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuTempText" Grid.Column="1" Text="—" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuFreqText" Grid.Column="2" Text="—" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuFanText" Grid.Column="3" Text="—" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuPowerText" Grid.Column="4" Text="—" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuUsageText" Grid.Column="5" Text="—" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar x:Name="CpuUsageBar" Grid.Column="6" Width="30" Height="7" Margin="4,0,0,0" Minimum="0" Maximum="100"
                             Foreground="#22D3EE" Background="#33FFFFFF" BorderThickness="0" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuMemoryText" Grid.Column="7" Text="—" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar x:Name="CpuMemoryBar" Grid.Column="8" Width="30" Height="7" Margin="4,0,0,0" Minimum="0" Maximum="100"
                             Foreground="#22D3EE" Background="#33FFFFFF" BorderThickness="0" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="BatteryPanel" Margin="0,4,0,0" HorizontalAlignment="Right">
                <TextBlock x:Name="BatteryText" Text="{x:Static loc:WpfStrings.BatteryInfo_Text}" Style="{DynamicResource MutedText}" FontSize="10" HorizontalAlignment="Right" />
                <TextBlock x:Name="BatteryDetailText" Text="" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right" Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
    <Button x:Name="LockButton" Content="🔒" Width="22" Height="22"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
            Visibility="Collapsed" Focusable="False" Click="LockButton_Click"
            ToolTip="{x:Static loc:WpfStrings.OverlayLockHint}"
            Background="#CC1F2937" Foreground="#F3F5F8" BorderThickness="0" />
    </Grid>
</Window>
