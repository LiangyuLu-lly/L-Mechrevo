<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>L-Mechrevo.WpfP0</AssemblyName>
    <RootNamespace>L_Mechrevo.WpfP0</RootNamespace>
    <StartupObject>L_Mechrevo.WpfP0.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\source\L-Mechrevo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\OPPOSansVariable.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\background.jpg" />
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
