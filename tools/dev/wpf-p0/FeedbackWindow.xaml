<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.FeedbackWindow_Title}"
        Width="560" Height="380"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static loc:WpfStrings.FeedbackWindow_Text_3}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{x:Static loc:WpfStrings.FeedbackWindow_Text_2}"
                       Style="{DynamicResource MutedText}" Margin="0,6,0,8" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel>
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock x:Name="DeviceText" Style="{DynamicResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:WpfStrings.FeedbackWindow_Text}"
                           Style="{DynamicResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{DynamicResource MutedText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:WpfStrings.FeedbackWindow_Content_3}" Style="{StaticResource FlatButton}" Click="CopyInfo_Click" />
                <Button Content="{x:Static loc:WpfStrings.FeedbackWindow_Content_2}" Style="{StaticResource FlatButton}" Click="Export_Click" />
                <Button Content="{x:Static loc:WpfStrings.FeedbackWindow_Content}" Style="{StaticResource FlatButton}" Click="Issues_Click" />
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content}" Style="{StaticResource FlatButton}" Click="Close_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
